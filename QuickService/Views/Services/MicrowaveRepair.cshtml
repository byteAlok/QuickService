    <!-- FAQs -->
    <section class="py-16 md:py-24 bg-gray-50 dark:bg-black">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Frequently Asked Questions</h2>
            </div>

            <style>
                details[open] summary .fa-plus {
                    display: none !important;
                }

                details[open] summary .fa-minus {
                    display: block !important;
                }

                details:not([open]) summary .fa-minus {
                    display: none !important;
                }
            </style>

            <div class="space-y-4">
                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Is it safe to repair a microwave?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
                    </summary>
                    <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed pl-1">
                        Yes, if done by professionals. We handle high-voltage components carefully and ensure the door seal is intact to prevent any radiation leakage.
                    </p>
                </details>

                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Why is my microwave sparking?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
                    </summary>
                    <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed pl-1">
                        Sparking (arcing) is often caused by metal objects left inside, burnt food debris on the waveguide cover (mica sheet), or damaged interior paint exposing metal.
                    </p>
                </details>

                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Microwave runs but doesn't heat?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
                    </summary>
                    <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed pl-1">
                        This is the most common issue, usually due to a failed magnetron (the component that produces microwaves), a blown high-voltage diode, or a faulty capacitor.
                    </p>
                </details>
            </div>
        </div>
