                            <td class="p-6 font-medium">Inspection / Visit Charge</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 250</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Ceiling Fan Installation</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 199</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Switch/Socket Replacement (Per Unit)</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 99</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">MCB Replacement</td>
