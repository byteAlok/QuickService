    <!-- Brands Strip -->
    <div class="py-8 bg-gray-50 dark:bg-black border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-6">Quality Brands We Work With</p>
            <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-80 grayscale hover:grayscale-0 transition-all duration-500">
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-600 cursor-default">HAVELLS</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-black cursor-default">ANCHOR</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-red-600 cursor-default">LEGRAND</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-800 cursor-default">PHILIPS</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white cursor-default">SCHNEIDER</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-green-600 cursor-default">CROMPTON</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-orange-600 cursor-default">ORIENT</span>
            </div>
        </div>
    </div>

    <!-- Diagnostic Hub: Common Issues -->
    <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-yellow-500 dark:text-yellow-400 font-semibold tracking-wider uppercase text-sm">Diagnosis</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">Electrical Problems?</h2>
                <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">We identify and fix electrical faults instantly.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Issue 1 -->
                <div class="p-6 rounded-2xl bg-gradient-to-br from-white to-yellow-50/30 dark:from-gray-800 dark:to-gray-900 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center text-red-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Short Circuit</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Sparks, burning smell, or sudden power outage.</p>
                </div>

                <!-- Issue 2 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-blue-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-toggle-off"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Switch Failure</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Switches or sockets not working, loose connections.</p>
                </div>

                <!-- Issue 3 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center text-yellow-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-fan"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Fan Issues</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Ceiling fan slow speed, wobbling, or noisy.</p>
                </div>

                <!-- Issue 4 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center text-purple-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-regular fa-lightbulb"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Frequent Trip</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">MCB tripping repeatedly due to overload or fault.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Steps -->
    <section class="py-16 md:py-24 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-yellow-500 dark:text-yellow-400 font-semibold tracking-wider uppercase text-sm">Process</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">How We Work</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                <!-- Line for desktop -->
                <div class="hidden md:block absolute top-[28%] left-[16%] right-[16%] h-0.5 bg-gradient-to-r from-gray-200 via-yellow-100 to-gray-200 dark:from-gray-800 dark:to-gray-800 -z-0"></div>

                <!-- Step 1 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-yellow-50 dark:border-gray-700 flex items-center justify-center text-yellow-500 dark:text-yellow-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">1. Diagnosis</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Testing circuits and load to find the exact fault.</p>
                </div>

                <!-- Step 2 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-yellow-50 dark:border-gray-700 flex items-center justify-center text-yellow-500 dark:text-yellow-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">2. Fixing</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Repair or replacement of parts with safety standards.</p>
                </div>

                <!-- Step 3 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-yellow-50 dark:border-gray-700 flex items-center justify-center text-yellow-500 dark:text-yellow-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">3. Verification</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Ensuring proper voltage and functionality before leaving.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Comprehensive Services -->
