                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-yellow-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-yellow-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">POPULAR</div>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-fan"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Fan Services</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Installation, un-installation, and repair of ceiling and exhaust fans.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Regulator change</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Capacitor replacement</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Noisy fan fix</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 249</span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-blue-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>

                <!-- Service Card 3 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-yellow-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-red-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-house-chimney-crack"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">MCB & Fuse</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Replacement of faulty MCBs, fuses, and main distribution board repairs.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Load balancing</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Short circuit fix</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> New MCB installation</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 399</span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-red-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
