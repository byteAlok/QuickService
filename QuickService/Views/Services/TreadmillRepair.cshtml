@{
    ViewData["Title"] =
        "Treadmill Repair Service in Hyderabad � Motor, Belt & Board Repair | QuickService";

    ViewData["Description"] =
        "Looking for treadmill repair service in Hyderabad? QuickService offers motor repair, belt replacement, speed issue fix, console board repair, noise problem & maintenance for home and gym treadmills. Verified technicians, doorstep service, affordable charges & easy online booking.";
}

    <!-- Hero Section -->
    <section class="relative bg-white dark:bg-gray-900 overflow-hidden py-10 lg:py-20 group">
        <!-- Modern Blobs -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600/10 dark:bg-orange-600/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-red-500/10 dark:bg-red-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
                <!-- Text Content -->
                <div class="lg:w-1/2 text-center lg:text-left order-2 lg:order-1">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 font-medium text-sm mb-6 border border-orange-100 dark:border-orange-800">
                        <i class="fa-solid fa-star text-yellow-500 text-xs"></i>
                        Top Rated Fitness Equipment Service
                    </div>

                    <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold mb-6 text-gray-900 dark:text-white leading-tight">
                        Expert <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-red-500">Treadmill Repair</span> & Maintenance
                    </h1>

                    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                        Keep your fitness journey on track. We repair all brands of treadmills, ellipticals, and gym equipment with precision and care.
                        <br><span class="text-sm mt-3 block font-medium text-gray-500 dark:text-gray-400"><i class="fa-solid fa-circle-info mr-1 text-orange-600"></i> Flat <span class="font-bold text-gray-900 dark:text-white">Rs. @SiteData.VisitCharge</span> visit charge (waived off on service).</span>
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="tel:+919648703048" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-orange-600 to-red-600 text-white font-bold rounded-full hover:shadow-lg hover:shadow-orange-500/30 transition-all transform hover:-translate-y-1">
                            <i class="fa-solid fa-phone mr-2"></i> Book Service Now
                        </a>
                        <a href="#pricing" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 font-bold rounded-full hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                            View Pricing
                        </a>
                    </div>

                    <div class="mt-8 flex flex-wrap justify-center lg:justify-start gap-x-6 gap-y-3 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-orange-600"></i> Fast Response
                        </div>
                        <div class="flex items-center gap-2 p-2">
                            <i class="fa-solid fa-shield-halved text-green-600"></i> 30-Day Warranty
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-user-check text-yellow-500"></i> Trained Experts
                        </div>
                    </div>
                </div>

                <!-- Hero Image (Constrained) -->
                <div class="lg:w-1/2 w-full flex justify-center order-1 lg:order-2">
                    <div class="relative w-full max-w-[550px]">
                        <div class="relative rounded-xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 group aspect-[4/3] lg:aspect-[16/10]">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60 z-10"></div>
                        <img src="~/images/services-img/technician_repairing_treadmill.png" alt="Professional Treadmill Repair Technician" class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105">

                            <!-- Floating Badge -->
                            <div class="absolute bottom-6 left-6 right-6 z-20">
                                <div class="bg-white/95 dark:bg-gray-900/90 backdrop-blur-md p-4 rounded-xl flex items-center justify-between shadow-lg border border-white/20">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400">
                                            <i class="fa-solid fa-heart-pulse"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-500 dark:text-gray-500 uppercase font-bold tracking-wide">Trusted By</p>
                                            <p class="font-semibold text-gray-900 dark:text-white">@SiteData.TrustedByGyms Gyms</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="flex text-yellow-500 text-xs mb-2">
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                        </div>
                                        <p class="text-xs font-bold text-gray-900 dark:text-white ml-2"> @SiteData.Rating Rating</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Decorative Elements -->
                        <div class="absolute -top-4 -right-4 w-20 h-20 bg-orange-600/20 rounded-full blur-xl -z-10 animate-pulse"></div>
                        <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-red-500/20 rounded-full blur-xl -z-10 animate-pulse" style="animation-delay: 1s;"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Brands Strip -->
    <div class="py-8 bg-gray-50 dark:bg-black border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-6">Expert Service For Leading Fitness Brands</p>
            <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-80 grayscale hover:grayscale-0 transition-all duration-500">
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-black cursor-default">NORDICTRACK</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-800 cursor-default">PROFORM</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-red-600 cursor-default">LIFE FITNESS</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-500 cursor-default">PRECOR</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white cursor-default">SOLE</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-green-600 cursor-default">FITKIT</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-red-700 cursor-default">POWERMAX</span>
            </div>
        </div>
    </div>

    <!-- Diagnostic Hub: Common Issues -->
    <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-orange-600 dark:text-orange-400 font-semibold tracking-wider uppercase text-sm">Diagnosis</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">Common Treadmill Issues?</h2>
                <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">Don't let a broken machine stop your workout.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Issue 1 -->
                <div class="p-6 rounded-2xl bg-gradient-to-br from-white to-orange-50/30 dark:from-gray-800 dark:to-gray-900 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center text-red-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Error Codes</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">E1, E2 errors on console often indicate motor or sensor faults.</p>
                </div>

                <!-- Issue 2 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-blue-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-person-falling"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Belt Slipping</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Loose or worn-out running belt causing jerky movement.</p>
                </div>

                <!-- Issue 3 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center text-yellow-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-volume-high"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Loud Noise</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Grinding sounds from motor or rollers needing lubrication.</p>
                </div>

                <!-- Issue 4 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center text-purple-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-power-off"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Not Starting</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Dead console, fuse blown, or motherboard issues.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Steps -->
    <section class="py-16 md:py-24 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-orange-600 dark:text-orange-400 font-semibold tracking-wider uppercase text-sm">Process</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">How We Fix It</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                <!-- Line for desktop -->
                <div class="hidden md:block absolute top-[28%] left-[16%] right-[16%] h-0.5 bg-gradient-to-r from-gray-200 via-orange-100 to-gray-200 dark:from-gray-800 dark:to-gray-800 -z-0"></div>

                <!-- Step 1 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-orange-50 dark:border-gray-700 flex items-center justify-center text-orange-600 dark:text-orange-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-stethoscope"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">1. Inspection</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Checking electronic boards, motor brushes, and belt tension.</p>
                </div>

                <!-- Step 2 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-orange-50 dark:border-gray-700 flex items-center justify-center text-orange-600 dark:text-orange-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">2. Repair</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Component level repair of PCBs and precise mechanical fixes.</p>
                </div>

                <!-- Step 3 -->
                <div class="text-center relative z-10 group">
                    <div class="w-20 h-20 mx-auto bg-white dark:bg-gray-800 rounded-full border-4 border-orange-50 dark:border-gray-700 flex items-center justify-center text-orange-600 dark:text-orange-400 text-3xl mb-6 shadow-sm group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-person-running"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">3. Testing</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 px-6">Load testing the machine to ensure it's safe for running.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Comprehensive Services -->
    <section id="services" class="py-16 md:py-24 bg-gray-50 dark:bg-black relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(#EA580C 1px, transparent 1px); background-size: 32px 32px;"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <span class="text-orange-600 dark:text-orange-400 font-semibold tracking-wider uppercase text-sm">Services</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">Comprehensive Treadmill Care</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Service Card 1 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-orange-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-orange-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-soap"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">General Service</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Complete cleaning, lubrication of belt and deck, and tension adjustment for smooth operation.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Silicon lubrication</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Dust removal from motor</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Sensor cleaning</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 799</span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-orange-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>

                <!-- Service Card 2 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-orange-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-orange-600 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">RECOMMENDED</div>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-microchip"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">PCB Repair</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Advanced repair of treadmill motherboard and console display circuits by electronics experts.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Component level fix</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Error code resolution</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Power fluctuation fix</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 1499 <span class="text-xs font-normal text-gray-400">onwards</span></span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-blue-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>

                <!-- Service Card 3 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-orange-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-red-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-wrench"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Belt Replacement</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Installation of new high-quality running belts or drive belts to restore smooth running.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Generic & Branded belts</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Proper tensioning</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Alignment check</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 999 <span class="text-xs font-normal text-gray-400">+ parts</span></span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-red-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Detailed Pricing Table -->
    <section id="pricing" class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Service Charges</h2>
                <p class="text-gray-600 dark:text-gray-400">Labor charges only. Spare parts like belts, motors, and PCBs are chargeable extra.</p>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-700 text-gray-500 dark:text-gray-300 text-sm uppercase tracking-wider">
                            <th class="p-6 font-semibold">Service Name</th>
                            <th class="p-6 font-semibold text-right">Price</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700 text-gray-700 dark:text-gray-300">
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Inspection / Visit Charge</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 350</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">General Service (Cleaning & Lube)</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 799</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Installation / Assembly</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 999</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">PCB Repair (Labor)</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 1499</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Running Belt Change (Labor)</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 999</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 bg-orange-50 dark:bg-orange-900/20 p-6 rounded-xl border border-orange-100 dark:border-orange-800 flex flex-col md:flex-row gap-4 items-center">
                <div class="w-12 h-12 rounded-full bg-orange-100 dark:bg-orange-800 flex items-center justify-center text-orange-600 dark:text-orange-300 shrink-0">
                    <i class="fa-solid fa-shield-cat"></i>
                </div>
                <div class="text-center md:text-left">
                    <h4 class="font-bold text-gray-900 dark:text-white text-lg">90-Day Service Warranty</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">We provide warranty on repaired parts and labor for 90 days.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Safety Section -->
    <section class="py-16 bg-orange-50/50 dark:bg-orange-900/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 lg:p-12 shadow-xl border border-orange-100 dark:border-gray-800 flex flex-col md:flex-row items-center gap-12 relative overflow-hidden">
                <!-- Blob -->
