@{
    ViewData["Title"] =
        "Washing Machine Repair Service in Hyderabad � Drum, Motor & Spin Issue Fix | QuickService";

    ViewData["Description"] =
        "Book expert washing machine repair service in Hyderabad for spin problem, water leakage, drum repair, motor fault, noise issue & installation. QuickService provides doorstep washing machine service by verified technicians with same-day repair, affordable charges & easy online booking.";
}

    <!-- Hero Section -->
    <section class="relative bg-white dark:bg-gray-900 overflow-hidden py-10 lg:py-20 group">
        <!-- Modern Blobs -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/10 dark:bg-blue-600/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-yellow-400/10 dark:bg-yellow-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
                <!-- Text Content -->
                <div class="lg:w-1/2 text-center lg:text-left order-2 lg:order-1">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-cyan-400 font-medium text-sm mb-6 border border-blue-100 dark:border-blue-800">
                        <i class="fa-solid fa-star text-yellow-500 text-xs"></i>
                        Expert Washer Technicians
                    </div>

                    <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold mb-6 text-gray-900 dark:text-white leading-tight">
                        Quick <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-red-400 to-yellow-500">Washing Machine</span> Repair
                    </h1>

                    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                        Machine not spinning? Water not draining? We repair Front Load, Top Load, and Semi-Automatic machines of all brands.
                        <br><span class="text-sm mt-3 block font-medium text-gray-500 dark:text-gray-400"><i class="fa-solid fa-circle-info mr-1 text-blue-600"></i> Flat <span class="font-bold text-gray-900 dark:text-white">Rs. @SiteData.VisitCharge</span> visit charge (waived off on service).</span>
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="tel:+919648703048" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-blue-600 via-red-400 to-yellow-500 text-white font-bold rounded-full hover:shadow-lg hover:shadow-blue-500/30 transition-all transform hover:-translate-y-1">
                            <i class="fa-solid fa-phone mr-2"></i> Book Washer Service
                        </a>
                        <a href="#pricing" class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 font-bold rounded-full hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                            View Pricing
                        </a>
                    </div>

                    <div class="mt-8 flex flex-wrap justify-center lg:justify-start gap-x-6 gap-y-3 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-blue-600"></i> Fast Repairs
                        </div>
                        <div class="flex items-center gap-2 p-2">
                            <i class="fa-solid fa-shield-halved text-green-600"></i> 90-Day Warranty
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-screwdriver-wrench text-yellow-500"></i> All Brands
                        </div>
                    </div>
                </div>

                <!-- Hero Image (Constrained) -->
                <div class="lg:w-1/2 w-full flex justify-center order-1 lg:order-2">
                    <div class="relative w-full max-w-[500px]">
                        <div class="relative rounded-xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 group aspect-[16/10]">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60 z-10"></div>
                        <img src="~/images/services-img/technician_repairing_washing_machine.png" alt="Professional Washing Machine Repair" class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105">

                            <!-- Floating Badge -->
                            <div class="absolute bottom-6 left-6 right-6 z-20">
                                <div class="bg-white/95 dark:bg-gray-900/90 backdrop-blur-md p-4 rounded-xl flex items-center justify-between shadow-lg border border-white/20">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400">
                                            <i class="fa-solid fa-check"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-500 dark:text-gray-500 uppercase font-bold tracking-wide">Trusted By</p>
                                            <p class="font-semibold text-gray-900 dark:text-white">@SiteData.TrustedBy Households</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="flex text-yellow-500 text-xs mb-2">
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                        </div>
                                        <p class="text-xs font-bold text-gray-900 dark:text-white ml-2"> @SiteData.Rating Rating</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Decorative Elements -->
                        <div class="absolute -top-4 -right-4 w-20 h-20 bg-blue-600/20 rounded-full blur-xl -z-10 animate-pulse"></div>
                        <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-yellow-400/20 rounded-full blur-xl -z-10 animate-pulse" style="animation-delay: 1s;"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Brands Strip -->
    <div class="py-8 bg-gray-50 dark:bg-black border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-6">Expert Service For Top Brands</p>
            <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-80 grayscale hover:grayscale-0 transition-all duration-500">
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-600 cursor-default">LG</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-800 cursor-default">SAMSUNG</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-gray-700 cursor-default">IFB</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-blue-500 cursor-default">WHIRLPOOL</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white cursor-default">BOSCH</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-cyan-600 cursor-default">GODREJ</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-gray-600 cursor-default">PANASONIC</span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300 hover:text-red-600 cursor-default">HAIER</span>
            </div>
        </div>
    </div>

    <!-- Diagnostic Hub: Common Issues -->
    <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-blue-600 dark:text-cyan-400 font-semibold tracking-wider uppercase text-sm">Diagnosis</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">Common Washing Machine Problems</h2>
                <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">We identify and fix the root cause.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Issue 1 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center text-red-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-spinner"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Not Spinning</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Belt issues, motor faults, or lid switch failure.</p>
                </div>

                <!-- Issue 2 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-blue-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-faucet-drip"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Not Draining</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Clogged drain pump or blocked outlet pipe.</p>
                </div>

                <!-- Issue 3 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center text-yellow-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Vibrating / Noisy</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Unbalanced load, worn bearings, or uneven legs.</p>
                </div>

                <!-- Issue 4 -->
                <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-all group">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center text-purple-600 mb-4 group-hover:scale-110 transition">
                        <i class="fa-solid fa-keyboard"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 dark:text-white mb-2">Error Codes</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">PCB logic errors or sensor malfunctions.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Comprehensive Services -->
    <section id="services" class="py-16 md:py-24 bg-gray-50 dark:bg-black relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(#fbbc05 1px, transparent 1px); background-size: 32px 32px;"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <span class="text-blue-600 dark:text-cyan-400 font-semibold tracking-wider uppercase text-sm">Services</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2">End-to-End Solutions</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Service Card 1 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-yellow-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-cyan-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-wrench"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Repair & Service</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Complete diagnostic and troubleshooting for any breakdown. Motor, timer, and pump repairs.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Expert diagnosis</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Drum cleaning</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Descaling service</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 350</span>
                        <a asp-action="ServiceBooking" asp-controller="Booking" class="text-cyan-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>

                <!-- Service Card 2 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-yellow-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-yellow-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">CRITICAL</div>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-microchip"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">PCB Repair</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Chip-level repair of electronic control boards (PCB) for automatic washing machines.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Error code fixes</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Component replacement</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Software reset</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 1200 <span class="text-xs font-normal text-gray-400">onwards</span></span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-blue-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>

                <!-- Service Card 3 -->
                <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 hover:bg-gradient-to-br hover:from-white hover:to-yellow-50 dark:hover:from-gray-900 dark:hover:to-gray-800 hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group hover:-translate-y-1">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-xl flex items-center justify-center text-2xl group-hover:bg-green-600 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-plug"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Install / Uninstall</h3>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                        Professional installation of new machines with proper leveling and tap connection.
                    </p>
                    <ul class="space-y-2 mb-6 text-sm font-medium text-gray-500 dark:text-gray-400">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Inlet/Outlet connection</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Vibration check</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-green-500"></i> Demo & Testing</li>
                    </ul>
                    <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
                        <span class="text-xl font-bold text-gray-900 dark:text-white">Rs. 499</span>
                    <a asp-action="ServiceBooking" asp-controller="Booking" class="text-green-600 font-semibold hover:tracking-wide transition-all text-sm">Book <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Detailed Pricing Table -->
    <section id="pricing" class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Service Pricing</h2>
                <p class="text-gray-600 dark:text-gray-400">Standard labor charges. Spare parts extra.</p>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-700 text-gray-500 dark:text-gray-300 text-sm uppercase tracking-wider">
                            <th class="p-6 font-semibold">Service</th>
                            <th class="p-6 font-semibold text-right">Semi-Auto</th>
                            <th class="p-6 font-semibold text-right">Fully-Auto</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700 text-gray-700 dark:text-gray-300">
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Visiting & Inspection</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 299</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 350</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">General Service / Cleaning</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 499</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 699</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Installation</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 450</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 599</td>
                        </tr>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition">
                            <td class="p-6 font-medium">Motor Replacement (Labor)</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 650</td>
                            <td class="p-6 text-right font-bold text-gray-900 dark:text-white">Rs. 950</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 p-6 rounded-xl border border-blue-100 dark:border-blue-800 flex flex-col md:flex-row gap-4 items-center">
                <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-300 shrink-0">
                    <i class="fa-solid fa-shield-cat"></i>
                </div>
                <div class="text-center md:text-left">
                    <h4 class="font-bold text-gray-900 dark:text-white text-lg">Warranty Assurance</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">30-day warranty on service. 90-day warranty on spare parts replaced.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQs -->
    <section class="py-16 md:py-24 bg-gray-50 dark:bg-black">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Frequently Asked Questions</h2>
            </div>

            <style>
                details[open] summary .fa-plus {
                    display: none !important;
                }

                details[open] summary .fa-minus {
                    display: block !important;
                }

                details:not([open]) summary .fa-minus {
                    display: none !important;
                }
            </style>

            <div class="space-y-4">
                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Why is my washing machine shaking violently?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
                    </summary>
                    <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed pl-1">
                        Violent shaking is usually caused by an unbalanced load, uneven flooring, or worn-out suspension rods/shock absorbers. Avoid overloading the machine.
                    </p>
                </details>

                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Water is not draining from the tub?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
                    </summary>
                    <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed pl-1">
                        This is mostly due to a clogged drain filter (coin trap) or a faulty drain pump. Coins, lint, or small items often block the passage.
                    </p>
                </details>

                <details class="group bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden open:ring-2 open:ring-blue-600/50 open:shadow-md transition">
                    <summary class="flex items-center justify-between cursor-pointer">
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">Do you repair motherboard (PCB)?</h3>
                        <span class="ml-4 shrink-0 w-8 h-8 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 group-open:text-blue-600 transition-colors">
                            <i class="fa-solid fa-plus"></i>
                            <i class="fa-solid fa-minus"></i>
                        </span>
