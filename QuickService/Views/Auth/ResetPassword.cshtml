@model QuickService.Models.ResetPasswordModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}
@section Styles{
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
        }
        .dark .glass-card {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .premium-title {
            background: linear-gradient(to right, #111827, #4b5563);
            -webkit-background-clip: text; color: transparent;
        }
        .dark .premium-title {
            background: linear-gradient(to right, #f9fafb, #d1d5db);
            -webkit-background-clip: text; color: transparent;
        }
        .btn-gradient {
            background: linear-gradient(to right, #4f46e5 0%, #0ea5e9 51%, #4f46e5 100%);
            background-size: 200% auto;
            border: none; transition: 0.5s;
        }
        .btn-gradient:hover {
            background-position: right center;
            box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);
            color: white; transform: translateY(-1px);
        }
        .toast-panel {
            background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(229, 231, 235, 1);
            color: #1f2937;
        }
        .dark .toast-panel {
            background: rgba(31, 41, 55, 0.9); border: 1px solid rgba(55, 65, 81, 1);
            color: #f3f4f6;
        }
    </style>
}
@{
    var errorMessage = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage;
    // var errorMessage = "Invalid email or password";
    var status = TempData["OTPVerfied"] as string;
    // var status = "OTP verified. Please create a new password.";
}

<div class="w-full max-w-md">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="flex justify-center mb-4 mx-8">

            <div class="flex items-center gap-3 px-6 py-3 border
                                border-red-300 bg-red-100 text-red-800
                                dark:border-red-600 dark:bg-red-900/40 dark:text-red-200
                                shadow-lg max-w-xl w-full rounded-md">
                <i class="fa-solid fa-triangle-exclamation text-2xl text-red-600 dark:text-red-200"></i>

                <div>
                    <h4 class="font-semibold pb-1 sm:pb-0 text-base leading-tight">
                        Error
                    </h4>

                    <p class="text-sm opacity-90">@errorMessage</p>
                </div>

            </div>

        </div>
    }
    @if (!string.IsNullOrEmpty(status))
    {
        <div class="flex justify-center mb-4 mx-8">
        <div class="flex items-center gap-3 px-6 py-3 border
                                                    border-cyan-400 bg-cyan-50 text-cyan-900
                                                    dark:border-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-100
                                                    shadow-lg max-w-xl w-full rounded-md">

            <i class="fa-solid fa-circle-check text-2xl text-cyan-600 dark:text-cyan-400"></i>

            <div>
                <h4 class="font-semibold text-base pb-1 sm:pb-0 leading-tight">
                    Congrats!
                </h4>
                <p class="text-sm opacity-90">@status</p>
            </div>
        </div>
        </div>
    }

    <!-- Card -->
    <div class="glass-card shadow-2xl rounded-2xl py-8 px-8">

        <!-- Header -->
        <div class="text-center mb-8">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: rgba(16, 185, 129, 0.1); color: #10b981; margin-bottom: 16px;">
                <svg style="width: 32px; height: 32px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold premium-title">
                Set New Password
            </h1>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Your password must be at least 8 characters long, and contain at least one uppercase letter and one number.
            </p>
        </div>

        <form method="post" asp-action="ResetPassword" asp-controller="Auth" id="resetPasswordForm" class="space-y-6">
            @Html.AntiForgeryToken()
           
            <div class="mb-5">
                <label class="block text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">Resetting Password For</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </span>
                    <input asp-for="Email" value="@Model.Email" readonly placeholder="Email Lost!.Try Again..." class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg pl-10 pr-3 py-2.5 text-slate-500 dark:text-slate-400 cursor-not-allowed" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-2 block"></span>
            </div>

            <!-- New Password -->
            <div class="mb-5">
                <label asp-for="NewPassword" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">New Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </span>
                    <input asp-for="NewPassword" type="password" id="newPasswordField" placeholder="••••••••" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-10 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                    <button type="button" onclick="togglePassword('newPasswordField', 'newEyeIcon')" class="absolute inset-y-0 right-2 flex items-center pr-2 text-slate-400 hover:text-blue-500 transition-colors" style="outline: none;">
                        <svg id="newEyeIcon" style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            
            <!-- Confirm Password -->
            <!-- Note: Assumption is that there is a ConfirmPassword property on AuthModel, if not, validation will be purely JS or removed if missing from model. Using pure HTML name attribute for now. -->
            <div class="mb-6">
                <label for="ConfirmPassword" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Confirm Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </span>
                    <input name="ConfirmPassword" type="password" id="confirmPasswordField" placeholder="••••••••" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-10 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                    <button type="button" onclick="togglePassword('confirmPasswordField', 'confirmEyeIcon')" class="absolute inset-y-0 right-2 flex items-center pr-2 text-slate-400 hover:text-blue-500 transition-colors" style="outline: none;">
                        <svg id="confirmEyeIcon" style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <!-- Optional validation span -->
            </div>

            <!-- Submit -->
            <button type="submit" id="resetBtn" class="btn-gradient w-full flex items-center justify-center gap-2 font-semibold py-3 rounded-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed text-white shadow-lg shadow-blue-500/30">
                <svg id="spinner" class="hidden animate-spin" style="height: 20px; width: 20px; color: white;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span id="btnText">Update Password</span>
            </button>
        </form>
    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePassword(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (field.type === "password") {
                field.type = "text";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />`;
            } else {
                field.type = "password";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
            }
        }

        document.getElementById("resetPasswordForm").addEventListener("submit", function (e) {

            if($(this).valid && !$(this).valid()) return;
            
            const btn = document.getElementById("resetBtn");
            btn.disabled = true;
            document.getElementById("spinner").classList.remove("hidden");
            document.getElementById("btnText").innerText = "Updating...";
        });

       
    </script>
}
