@model QuickService.Models.ForgotPasswordModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}
@section Styles {
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
        }
        .dark .glass-card {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .premium-title {
            background: linear-gradient(to right, #111827, #4b5563);
            -webkit-background-clip: text; color: transparent;
        }
        .dark .premium-title {
            background: linear-gradient(to right, #f9fafb, #d1d5db);
            -webkit-background-clip: text; color: transparent;
        }
        .btn-gradient {
            background: linear-gradient(to right, #4f46e5 0%, #0ea5e9 51%, #4f46e5 100%);
            background-size: 200% auto;
            border: none; transition: 0.5s;
        }
        .btn-gradient:hover {
            background-position: right center;
            box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);
            color: white; transform: translateY(-1px);
        }
        .toast-panel {
            background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(229, 231, 235, 1);
            color: #1f2937;
        }
        .dark .toast-panel {
            background: rgba(31, 41, 55, 0.9); border: 1px solid rgba(55, 65, 81, 1);
            color: #f3f4f6;
        }
    </style>
}

@{
    var errorMessage = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage;
    // var errorMessage = "Invalid email or password";

    var status = TempData["ErrorType"] as string;
    // var status = "Server-side error or failed!. Please try again.";

}

<div class="w-full max-w-md">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="flex justify-center mb-4 mx-8">

            <div class="flex items-center gap-3 px-6 py-3 border
                            border-red-300 bg-red-100 text-red-800
                            dark:border-red-600 dark:bg-red-900/40 dark:text-red-200
                            shadow-lg max-w-xl w-full rounded-md">
                <i class="fa-solid fa-triangle-exclamation text-2xl text-red-600 dark:text-red-200"></i>

                <div>
                    <h4 class="font-semibold pb-1 sm:pb-0 text-base leading-tight">
                        Error
                    </h4>

                    <p class="text-sm opacity-90">@errorMessage</p>
                </div>

            </div>

        </div>
    }

    @if (!string.IsNullOrEmpty(status))
    {
        <div class="flex justify-center mb-4 mx-8">
            <div class="flex items-center gap-3 px-6 py-3 border border-red-300 bg-red-100 text-red-800
                        dark:border-red-600 dark:bg-red-900/40 dark:text-red-200 shadow-lg max-w-xl w-full rounded-md">

                    <i class="fa-solid fa-triangle-exclamation text-2xl text-red-600 dark:text-red-200"></i>

                    <div>
                        <h4 class="font-semibold pb-1 sm:pb-0 text-base leading-tight">
                            Error
                        </h4>
                        <p class="text-sm opacity-90">@status</p>
                    </div>
                </div>
        </div>
    }

    <!-- Card -->
    <div class="glass-card shadow-2xl rounded-2xl py-6 px-8">

        <!-- Header -->
        <div class="text-center mb-6">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 14px; background: rgba(239, 68, 68, 0.1); color: #ef4444; margin-bottom: 12px;">
                <svg style="width: 28px; height: 28px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold premium-title">
                Forgot Password
            </h1>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Enter your email address to receive a one-time password (OTP) for resetting your password.
            </p>
        </div>

        <form method="post" id="forgotPasswordForm" asp-action="ForgotPassword" asp-controller="Auth" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="mb-5">
                <label asp-for="Email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Email Address *</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </span>
                    <input asp-for="Email" placeholder="user@example.com" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-10 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div class="mb-5">
                <label asp-for="User"
                       class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                    Select User *
                </label>

                <div class="relative">

                    <select asp-for="User"
                            class="w-full bg-slate-50 dark:bg-slate-900
                   border border-slate-300 dark:border-slate-600
                   rounded-lg px-3 py-2.5 pr-10
                   text-slate-700 dark:text-slate-200
                   focus:outline-none focus:ring-2 focus:ring-blue-500
                   hover:border-blue-400
                   transition-all appearance-none">

                        <option value="">-- Select User Type --</option>
                        <option value="Admin">Admin or Manager</option>
                        <option value="Staff">Staff</option>

                    </select>

                    <!-- custom dropdown icon -->
                    <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-4 w-4"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M19 9l-7 7-7-7" />

                        </svg>
                    </div>

                </div>

                <span asp-validation-for="User"
                      class="text-xs text-red-500 mt-1 block"></span>
            </div>


            <!-- Submit -->
            <button type="submit" id="submitBtn" class="btn-gradient w-full flex items-center justify-center gap-2 font-semibold py-3 rounded-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed text-white shadow-lg shadow-blue-500/30">
                <svg id="spinner" class="hidden animate-spin" style="height: 20px; width: 20px; color: white;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span id="btnText">Send OTP</span>
                <svg style="width: 18px; height: 18px; margin-left: 4px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </button>
            
            <div class="flex justify-center mt-4">
                <a href="@Url.Action("Login", "Auth")" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm">
                    <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Login
                </a>
            </div>
            <div class="flex justify-center mt-4">
                <a href="@Url.Action("ForgotPassword", "Auth")" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm">
                    Refresh Form<i class="fa-solid fa-arrow-rotate-right ml-2"></i>
                </a>
            </div>
        </form>

    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.getElementById("forgotPasswordForm").addEventListener("submit", function (e) {
            if($(this).valid && !$(this).valid()) return;
            
            const btn = document.getElementById("submitBtn");
            btn.disabled = true;
            document.getElementById("spinner").classList.remove("hidden");
            document.getElementById("btnText").innerText = "Sending...";
        });

       
    </script>
}
