<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Core -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "QuickService")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Appliance repair service")" />
    @* @await RenderSectionAsync("Head", required: false) *@

    <!-- Global meta -->
    <meta name="author" content="@SiteData.CompanyName" />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content="ASP.NET Core MVC" />

    <!-- Canonical -->
    <link rel="canonical" href="@(ViewData["Canonical"] ?? $"{SiteData.SiteUrl}{Context.Request.Path}")" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteData.CompanyName" />
    <meta property="og:title" content="QuickService – Home Appliance Repair & Service" />
    <meta property="og:description" content="Book trusted appliance repair services at home. AC, Refrigerator, Washing Machine, RO & more." />
    <meta property="og:url" content="@($"{SiteData.SiteUrl}/")" />
    <meta property="og:image" content="@($"{SiteData.SiteUrl}/icons/og-home.png")" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="QuickService – Home Appliance Repair & Service" />
    <meta name="twitter:description" content="Fast & trusted appliance repair service. Book online now." />
    <meta name="twitter:image" content="@($"{SiteData.SiteUrl}/icons/og-home.png")" />

    <!-- Local Business Schema -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "LocalBusiness",
          "name": "@SiteData.CompanyName",
          "image": "@($"{SiteData.SiteUrl}/icons/og-home.png")",
          "logo": "@($"{SiteData.SiteUrl}/icons/icon-384.png")",
          "url": "@SiteData.SiteUrl",
          "telephone": "@SiteData.OwnerPhone",
          "description": "Home appliance repair service platform offering AC, Refrigerator, Washing Machine, RO, TV repair services."
          "priceRange": "₹199-₹3000",
          "openingHours": "Mo-Su 08:00-21:00",
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "@SiteData.OwnerPhone",
            "contactType": "customer support",
            "areaServed": "IN"
          },
          "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Hyderabad",
            "addressRegion": "Telangana",
            "postalCode": "500001",
            "addressCountry": "IN"
          },
          "areaServed": {
            "@@type": "Country",
            "name": "India"
          },
          "sameAs": @Html.Raw(JsonSerializer.Serialize(SiteData.SameAs))
        }
    </script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="384x384" href="~/icons/icon-384.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/icon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="~/icons/icon-48.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-icon-180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="~/icons/icon-512.png">

    <link rel="manifest" href="~/applicationManifest.json">
    <meta name="theme-color" content="#175a91">

    <!-- CSS -->
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Fonts & icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Inline styles -->
    <style>
        html {
            scroll-behavior: smooth;
        }

        .scrollbar-hide::-webkit-scrollbar {
            height: 3px;
        }

        .scrollbar-hide::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar-hide::-webkit-scrollbar-thumb {
            background: linear-gradient(to right, #38bdf8, #6366f1);
            border-radius: 20px;
        }

            .scrollbar-hide::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(to right, #22d3ee, #818cf8);
            }

        .scrollbar-hide {
            scrollbar-width: thin;
            scrollbar-color: #6366f1 transparent;
        }

        .form-label {
            @@apply block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2;
        }

        .form-input {
            @@apply w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all duration-200;
        }
   
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

    <body class="font-sans antialiased text-gray-800 bg-gradient-to-br from-slate-50 via-gray-50 to-blue-50 dark:from-gray-950 dark:via-gray-900 dark:to-slate-900 dark:text-gray-200 transition-colors duration-500 selection:bg-blue-500 selection:text-white">

        <!-- Top Disclaimer -->
        <div id="disclaimer" class="bg-gray-900 text-white text-sm py-1.5 text-center px-4 relative z-50 border-b border-gray-800">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <p class="opacity-90 flex-1 text-center">
                <i class="fa-solid fa-circle-info mr-2 text-blue-500"></i>
                <span class="hidden sm:inline text-xs lg:text-sm font-semibold">Transparency Notice:</span> We are an
                independent third-party service provider & not affiliated with any specific brand.
            </p>
        </div>
    </div>

        <!-- NAVBAR -->
        <nav class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md shadow-sm border-b border-gray-200/50 dark:border-gray-800/50 sticky top-0 z-[100] transition-all duration-300 supports-[backdrop-filter]:bg-white/60 dark:supports-[backdrop-filter]:bg-gray-900/60">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center h-20">

                <!-- Logo -->
                <div class="flex items-center gap-2">
                    
                    <a href="/" class="flex items-center gap-2">
                         <div class="w-10 h-10 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-blue-600 dark:text-cyan-400">
                            <i class="fa-solid fa-wrench text-xl"></i>
                        </div>
                        <span class="font-bold text-2xl xl:text-[22px] text-gray-900 dark:text-white">
                            Quick<span class="text-blue-600 dark:text-cyan-400">Service</span>
                        </span> 
                    </a>
                    @* <a href="/">
                        <!-- Light Mode Logo -->
                        <img src="~/icons/QuickServiceLogo.png" alt="QuickService"
                             class="block dark:hidden w-54 sm:w-56 lg:w-66 xl:w-72" />

                        <!-- Dark Mode Logo -->
                        <img src="~/icons/QuickServiceLogo_White.png" alt="QuickService"
                             class="hidden dark:block w-54 sm:w-56 lg:w-66 xl:w-72" />
                    </a> *@
                </div>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-5 lg:gap-8">

                    <!-- Home -->
                    <a href="/"
                       class="text-gray-800 font-medium dark:text-gray-300 hover:text-blue-600 dark:hover:text-cyan-400">
                        Home
                    </a>

