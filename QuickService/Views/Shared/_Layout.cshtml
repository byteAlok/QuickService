                                            <i class="fa-solid fa-list"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Our Services</span>
                                            <span class="block text-xs text-gray-500">Visit Services Page</span>
                                        </div>
                                    </a>
                                    <hr class="border-gray-200 dark:border-gray-700">
                                    <!-- AC -->
                                        <a asp-action="AcRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-600 flex items-center justify-center">
                                            <i class="fa-solid fa-snowflake"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">AC Repair</span>
                                            <span class="block text-xs text-gray-500">Service, Gas, Installation</span>
                                        </div>
                                    </a>

                                    <!-- Refrigerator -->
                                        <a asp-action="RefrigeratorRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-green-50 dark:hover:bg-green-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/40 text-green-600 flex items-center justify-center">
                                            <i class="fa-solid fa-temperature-low"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Refrigerator Repair</span>
                                            <span class="block text-xs text-gray-500">Double Door, Inverter</span>
                                        </div>
                                    </a>

                                    <!-- Washing Machine -->
                                        <a asp-action="WashingMachineRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-yellow-50 dark:hover:bg-yellow-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-yellow-100 dark:bg-yellow-900/40 text-yellow-500 flex items-center justify-center">
                                            <i class="fa-solid fa-shirt"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Washing Machine</span>
                                            <span class="block text-xs text-gray-500">Front & Top Load</span>
                                        </div>
                                    </a>

                                    <!-- Microwave -->
                                        <a asp-action="MicrowaveRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-900/40 text-red-500 flex items-center justify-center">
                                            <i class="fa-solid fa-fire"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Microwave Repair</span>
                                            <span class="block text-xs text-gray-500">Oven, Convection</span>
                                        </div>
                                    </a>

                                    <!-- LED TV -->
                                        <a asp-action="LedTvRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-purple-50 dark:hover:bg-purple-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/40 text-purple-500 flex items-center justify-center">
                                            <i class="fa-solid fa-tv"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">LED TV Repair</span>
                                            <span class="block text-xs text-gray-500">Display & Audio</span>
                                        </div>
                                    </a>

                                    <!-- Geyser -->
                                        <a asp-action="GeyserRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-orange-50 dark:hover:bg-orange-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-orange-100 dark:bg-orange-900/40 text-orange-500 flex items-center justify-center">
                                            <i class="fa-solid fa-temperature-high"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Geyser Repair</span>
                                            <span class="block text-xs text-gray-500">Heating Issues</span>
                                        </div>
                                    </a>

                                    <!-- RO -->
                                        <a asp-action="RoPurifierRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-cyan-50 dark:hover:bg-cyan-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-cyan-100 dark:bg-cyan-900/40 text-cyan-500 flex items-center justify-center">
                                            <i class="fa-solid fa-droplet"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">RO Water Purifier</span>
                                            <span class="block text-xs text-gray-500">Filter Change, Service</span>
                                        </div>
                                    </a>

                                    <!-- Treadmill -->
                                        <a asp-action="TreadmillRepair" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-orange-50 dark:hover:bg-orange-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-orange-100 dark:bg-orange-900/40 text-orange-600 flex items-center justify-center">
                                            <i class="fa-solid fa-person-running"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Treadmill Repair</span>
                                            <span class="block text-xs text-gray-500">Belt, Motor, PCB</span>
                                        </div>
                                    </a>

                                    <!-- Electrical -->
                                        <a asp-action="ElectricalWork" asp-controller="Services"
                                       class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-yellow-50 dark:hover:bg-yellow-900/20">
                                        <span class="w-10 h-10 rounded-lg bg-yellow-100 dark:bg-yellow-900/40 text-yellow-600 flex items-center justify-center">
                                            <i class="fa-solid fa-bolt"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Electrical Work</span>
                                            <span class="block text-xs text-gray-500">Wirings, Switches</span>
                                        </div>
