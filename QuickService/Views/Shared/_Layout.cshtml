                                            <i class="fa-solid fa-user"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">About Us</span>
                                            <span class="block text-xs text-gray-500">Who we are</span>
                                        </div>
                                    </a>
                                    <hr class="border-gray-200 dark:border-gray-700">

                                    <!-- contact -->
                                        <a asp-action="ContactUs" asp-controller="About" class="lg:hidden flex items-center gap-3 px-3 py-2 rounded-lg
