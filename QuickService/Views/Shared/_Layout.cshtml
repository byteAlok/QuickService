                                        <a asp-action="PrivacyPolicy" asp-controller="About" class="flex items-center gap-3 px-3 py-2 rounded-lg
                          hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                                        <span class="w-9 h-9 rounded-lg bg-gray-200 dark:bg-gray-700
                                 text-gray-700 dark:text-gray-200 flex items-center justify-center">
                                            <i class="fa-solid fa-shield-halved"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Privacy Policy</span>
                                            <span class="block text-xs text-gray-500">Your data safety</span>
                                        </div>
                                    </a>

                                    <!-- Terms -->
                                        <a asp-action="TermsAndConditions" asp-controller="About" class="flex items-center gap-3 px-3 py-2 rounded-lg
                          hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                                        <span class="w-9 h-9 rounded-lg bg-gray-200 dark:bg-gray-700
                                 text-gray-700 dark:text-gray-200 flex items-center justify-center">
                                            <i class="fa-solid fa-file-contract"></i>
                                        </span>
                                        <div>
                                            <span class="block font-semibold">Terms & Conditions</span>
                                            <span class="block text-xs text-gray-500">Legal terms</span>
                                        </div>
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Contact -->
                        <a asp-action="ContactUs" asp-controller="About"
                       class="hidden lg:block text-gray-800 font-medium dark:text-gray-300 hover:text-blue-600 dark:hover:text-cyan-400">
                        Contact
                    </a>

                    <button onclick="toggleDarkMode()"
                            class="relative w-10 h-10 rounded-full
         bg-gray-100 dark:bg-gray-800
         text-gray-600 dark:text-yellow-300
         flex items-center justify-center">

                        <!-- Moon (light mode) -->
                        <i class="fa-solid fa-moon absolute
            opacity-100 dark:opacity-0
            transition-opacity duration-200"></i>

                        <!-- Sun (dark mode) -->
                        <i class="fa-solid fa-sun absolute
            opacity-0 dark:opacity-100
            transition-opacity duration-200"></i>

                    </button>



                    <!-- CTA -->
                        <a asp-action="ServiceBooking" asp-controller="Booking" class="bg-gradient-to-r from-blue-600 to-purple-700
              text-white text-sm lg:text-base px-6 py-2 rounded-full font-medium shadow-lg hover:scale-105 transition">
                        Book Repair Online
                    </a>
                </div>



                <!-- Dark/Light -->
                <div class="md:hidden flex items-center gap-6 me-4 sm:me-8">

                    <!-- Mobile -->
                    <!-- CTA -->
                        <a asp-action="ServiceBooking" asp-controller="Booking" class="hidden sm:block md:hidden bg-gradient-to-r from-blue-600 to-purple-700
              text-white text-sm lg:text-base px-6 py-2 rounded-full font-medium shadow-lg hover:scale-105 transition">
                        Book Repair Online
                    </a>

                    <button onclick="toggleDarkMode()"
                            class="relative w-10 h-10 rounded-full
         bg-gray-100 dark:bg-gray-800
         text-gray-600 dark:text-yellow-300
         flex items-center justify-center">

                        <!-- Moon (light mode) -->
                        <i class="fa-solid fa-moon absolute
            opacity-100 dark:opacity-0
            transition-opacity duration-200"></i>

                        <!-- Sun (dark mode) -->
