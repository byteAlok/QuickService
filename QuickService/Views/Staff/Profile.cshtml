@using QuickService.Helpers
@model QuickService.Models.StaffModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Profile Settings";
}
@{
    var updateMsg = TempData["StaffUpdateStatus-Profile"] as string;
    var updateType = TempData["StaffUpdateType-Profile"] as string;
}

@if (!string.IsNullOrEmpty(updateMsg))
{
    <div class="px-6 pt-4">
        <div class="flex items-center gap-3 px-4 py-3 border rounded-xl shadow-sm @(updateType == "success" ? "border-green-200 bg-green-50 text-green-800 dark:border-green-900/50 dark:bg-green-900/20 dark:text-green-200" : "border-red-200 bg-red-50 text-red-800 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-200")">
            <i class="fa-solid @(updateType == "success" ? "fa-circle-check" : "fa-circle-exclamation") text-base"></i>
            <p class="text-sm font-semibold tracking-tight">@updateMsg</p>
        </div>
    </div>
}

<div class="container mx-auto px-4 py-8" x-data="staffProfileManager()">
    <!-- Header Section -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Account Profile</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">View your performance, personal details, and security settings.</p>
        </div>
        <div class="flex items-center gap-3">
            <button @@click="toggleEdit()" type="button" 
                    :class="isEditMode ? 'bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
                    class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 shadow-sm">
                <span x-text="isEditMode ? 'Cancel' : 'Edit Profile'"></span>
            </button>
            <div x-show="isEditMode" x-cloak class="flex items-center gap-2">
                <button form="staff-profile-form" type="submit" id="save-btn"
                        class="inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 transition-all duration-200 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    <span id="save-btn-text">Save Changes</span>
                    <svg id="save-btn-spinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Sidebar: Profile & Performance -->
        <div class="lg:col-span-4 space-y-6">
            <!-- Profile Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden text-center p-6">
                <div class="relative inline-block">

                    <div class="h-32 w-32 rounded-full border-4 border-emerald-50 dark:border-gray-700 bg-white dark:bg-gray-700 shadow-sm overflow-hidden flex items-center justify-center mx-auto">

                        <img id="profile-preview"
                             src="@Url.Content(Model.staff_image ?? "")"
                             data-old-src="@Url.Content(Model.staff_image ?? "")"
                             class="h-full w-full object-cover hidden" />

                        <div id="avatar-fallback"
                             class="font-bold text-lg text-emerald-600 dark:text-emerald-400">
                             @(Model.staff_name?.Length > 0 ? Model.staff_name[0].ToString() : "S")
                        </div>

                    </div>

                    <label for="staff_image"
                           :class="isEditMode ? 'bg-emerald-600 cursor-pointer hover:bg-emerald-700' : 'bg-gray-400 cursor-not-allowed opacity-50'"
                           :style="!isEditMode && 'pointer-events: none'"
                           class="absolute bottom-0 right-0 p-2 rounded-full shadow-lg border-2 border-white dark:border-gray-800 transition-all">

                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                        </svg>
                    </label>
                </div>

                <h2 class="mt-4 text-xl font-bold text-gray-900 dark:text-white">@Model.staff_name</h2>
                <div class="mt-1 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400">
                    @Model.staff_skill
                </div>

                <div class="mt-6 space-y-2 border-t border-gray-50 dark:border-gray-700 pt-6">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500 dark:text-gray-400">Status</span>
                        <span class="break-all font-semibold @(Model.staff_status ? "text-green-600 dark:text-green-400" : "text-red-500")">
                            @TimeHelper.GetStatusText(Model.staff_status)
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500 dark:text-gray-400">Member Since</span>
                        <span class="break-all font-semibold text-gray-900 dark:text-white">
                            @Model.staff_register_date.ToString("yyyy-MM-dd")
                        </span>
                    </div>
                    <div class="flex justify-between text-sm text-center" title="IST: @(Model.staff_last_login.HasValue ? TimeHelper.ConvertToIst(Model.staff_last_login.Value).ToString("G") : "N/A")">
                        <span class="text-gray-500 dark:text-gray-400">Last Login</span>
                        <span class="break-all font-semibold text-gray-900 dark:text-white">
                            @TimeHelper.GetTimeAgo(Model.staff_last_login)
                        </span>
                    </div>
                </div>

                <button type="button" onclick="location.href='@Url.Action("ForgotPassword", "Auth")'" class="mt-8 w-full py-2.5 px-4 bg-gray-50 dark:bg-gray-700/50 hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 font-semibold rounded-xl border border-gray-200 dark:border-gray-600 transition-all duration-200">
                    Change Password
                </button>
            </div>

            <!-- Customization Widget -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                <h3 class="text-md font-bold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                    Page Visibility
                </h3>
                <div class="mt-4 space-y-3">
                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-sm text-gray-600 dark:text-gray-400">Basic Info Section</span>
                        <input type="checkbox" x-model="showContact" class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                    </label>
                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-sm text-gray-600 dark:text-gray-400">Address Section</span>
                        <input type="checkbox" x-model="showAddress" class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                    </label>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-8">
            <form id="staff-profile-form" asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="space-y-6" onsubmit="handleFormSubmit(event)">
                <input type="file" id="staff_image" name="staff_image" asp-for="staff_image" accept="image/png, image/jpeg, image/webp" class="hidden" onchange="previewAvatar(this)">

                <!-- Basic Information -->
                <div x-show="showContact" x-transition class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Basic Details</h3>
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400 text-xs font-bold rounded-full">Available</span>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1">
                            <label asp-for="staff_name" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Full Name</label>
                            <input asp-for="staff_name" :disabled="!isEditMode"
                                   class="break-all block w-full px-4 py-3 border-gray-200 dark:border-gray-700 dark:bg-gray-900 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm disabled:bg-gray-50 dark:disabled:bg-gray-800 disabled:text-gray-500 transition-all">
                            <span asp-validation-for="staff_name" class="text-xs text-red-500"></span>
                        </div>

                        <div class="space-y-1">
                            <label asp-for="staff_phone" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Phone Number</label>
                            <input asp-for="staff_phone" :disabled="!isEditMode"
                                   class="break-all block w-full px-4 py-3 border-gray-200 dark:border-gray-700 dark:bg-gray-900 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm disabled:bg-gray-50 dark:disabled:bg-gray-800 disabled:text-gray-500 transition-all">
                            <span asp-validation-for="staff_phone" class="text-xs text-red-500"></span>
                        </div>

                        <div class="space-y-1">
                            <label asp-for="staff_email" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Email Address</label>
                            <input asp-for="staff_email" :disabled="!isEditMode"
                                   class="break-all block w-full px-4 py-3 border-gray-200 dark:border-gray-700 dark:bg-gray-900 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm disabled:bg-gray-50 dark:disabled:bg-gray-800 disabled:text-gray-500 transition-all">
                            <span asp-validation-for="staff_email" class="text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>

                <!-- Address Information -->
                <div x-show="showAddress" x-transition class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Service Location</h3>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="md:col-span-2 space-y-1">
                            <label asp-for="staff_address" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Street Address</label>
                            <input asp-for="staff_address" :disabled="!isEditMode"
                                   class="break-all block w-full px-4 py-3 border-gray-200 dark:border-gray-700 dark:bg-gray-900 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm disabled:bg-gray-50 dark:disabled:bg-gray-800 disabled:text-gray-500 transition-all">
                            <span asp-validation-for="staff_address" class="text-xs text-red-500"></span>
                        </div>
                        <div class="space-y-1">
                            <label asp-for="staff_city_state" class="text-sm font-semibold text-gray-700 dark:text-gray-300">City / State</label>
                            <input asp-for="staff_city_state" :disabled="!isEditMode"
                                   class="break-all block w-full px-4 py-3 border-gray-200 dark:border-gray-700 dark:bg-gray-900 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm disabled:bg-gray-50 dark:disabled:bg-gray-800 disabled:text-gray-500 transition-all">
                            <span asp-validation-for="staff_city_state" class="text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>

                <!-- Professional Information (Readonly) -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Expertise & History</h3>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1">
                            <label asp-for="staff_skill" class="text-sm font-semibold text-gray-500">Main Skill</label>
                            <input asp-for="staff_skill" readonly class="break-all block w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-400 rounded-xl sm:text-sm cursor-not-allowed">
                        </div>
                        <div class="space-y-1">
                            <label asp-for="staff_register_date" class="text-sm font-semibold text-gray-500">Employee Since</label>
                            <input value="@TimeHelper.ConvertToIst(Model.staff_register_date).ToString("yyyy-MM-dd HH:mm")" readonly class="break-all block w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-400 rounded-xl sm:text-sm cursor-not-allowed">
                        </div>
                        <div class="space-y-1">
                            <label asp-for="staff_last_login" class="text-sm font-semibold text-gray-500">Last Login Time</label>
                            <input value="@(Model.staff_last_login.HasValue ? TimeHelper.ConvertToIst(Model.staff_last_login.Value).ToString("G") : "N/A")" readonly class="break-all block w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-400 rounded-xl sm:text-sm cursor-not-allowed">
                        </div>
                        <div class="space-y-1">
                            <label asp-for="staff_status" class="text-sm font-semibold text-gray-500">Job Status</label>
                            <input asp-for="staff_status" type="text" readonly class="break-all block w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-400 rounded-xl sm:text-sm cursor-not-allowed">
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

    <script>
        function staffProfileManager(){
            return{
                isEditMode:false,
                showContact:true,
                showAddress:true,
                toggleEdit(){this.isEditMode=!this.isEditMode;}
            }
        }

        let preview,fallback;

        document.addEventListener("DOMContentLoaded",function(){
            preview=document.getElementById("profile-preview");
            fallback=document.getElementById("avatar-fallback");
            initializeAvatar();
        });

        function initializeAvatar(){
            const oldSrc=preview?.dataset?.oldSrc;
            if(oldSrc&&oldSrc.trim()!==""){
                preview.src=oldSrc;
                preview.classList.remove("hidden");
                fallback.classList.add("hidden");
            }else{
                preview.classList.add("hidden");
                fallback.classList.remove("hidden");
            }
        }

        function previewAvatar(input){
            if(input.files&&input.files[0]){
                const reader=new FileReader();
                reader.onload=function(e){
                    preview.src=e.target.result;
                    preview.classList.remove("hidden");
                    fallback.classList.add("hidden");
                };
                reader.readAsDataURL(input.files[0]);
            }else{
                initializeAvatar();
            }
        }

        function handleFormSubmit(){
            const btn=document.getElementById("save-btn");
            const txt=document.getElementById("save-btn-text");
            const spin=document.getElementById("save-btn-spinner");
            btn.disabled=true;
            txt.innerText="Updating Profile...";
            spin.classList.remove("hidden");
        }
    </script>

    <style>
        [x-cloak] {
            display: none !important
        }</style>
}
