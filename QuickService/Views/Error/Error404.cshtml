@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Page Not Found";
}

<div class="relative w-full overflow-hidden rounded-2xl bg-white dark:bg-slate-800 shadow-xl border border-slate-100 dark:border-slate-700 p-8 md:p-12 lg:p-16 text-center transform transition-all duration-500 hover:shadow-2xl">
    <!-- Dynamic Background Gradients specific to 404 -->
    <div class="absolute inset-0 pointer-events-none opacity-50 dark:opacity-20 z-0">
        <div class="absolute top-0 right-0 w-64 h-64 bg-sky-200 dark:bg-sky-900 rounded-full blur-3xl opacity-50 transform translate-x-1/3 -translate-y-1/3"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-indigo-200 dark:bg-indigo-900 rounded-full blur-3xl opacity-50 transform -translate-x-1/3 translate-y-1/3"></div>
    </div>

    <div class="relative z-10 flex flex-col items-center max-w-4xl mx-auto">
        <!-- Main 404 Visual / SVG Illustration -->
        <div class="relative mb-8 w-full max-w-sm mx-auto group [perspective:1000px]">
            <div class="absolute inset-0 bg-sky-400/20 dark:bg-sky-900/40 rounded-full filter blur-3xl transform scale-75 group-hover:scale-100 transition-transform duration-700 ease-in-out"></div>
            
            <!-- Custom 404 Illustration (Magnifying Glass over empty box) -->
            <svg class="w-full h-auto text-slate-800 dark:text-slate-200 relative z-10 animate-[bounce_3s_infinite]" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Box -->
                <path d="M120 200L200 240L280 200V120L200 80L120 120V200Z" fill="url(#paint0_linear)" fill-opacity="0.1" stroke="currentColor" stroke-width="6" stroke-linejoin="round"/>
                <path d="M200 240V160M120 120L200 160M280 120L200 160" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                <!-- Magnifying Glass -->
                <circle cx="250" cy="110" r="40" fill="currentColor" fill-opacity="0.05" stroke="#0ea5e9" stroke-width="8"/>
                <path d="M280 140L330 190" stroke="#0ea5e9" stroke-width="12" stroke-linecap="round"/>
                <!-- Question Mark inside Glass -->
                <path d="M240 100C240 94.4772 244.477 90 250 90C255.523 90 260 94.4772 260 100C260 105.523 250 110 250 110" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="250" cy="125" r="4" fill="currentColor"/>
                <!-- Floating Elements -->
                <circle cx="80" cy="70" r="10" fill="#38bdf8" fill-opacity="0.4" class="animate-pulse"/>
                <circle cx="320" cy="230" r="15" fill="#818cf8" fill-opacity="0.3" class="animate-pulse" style="animation-delay: 1s;"/>
                <path d="M100 240L110 250M110 240L100 250" stroke="#94a3b8" stroke-width="4" stroke-linecap="round" class="animate-bounce" style="animation-delay: 0.5s;"/>
                
                <defs>
                    <linearGradient id="paint0_linear" x1="200" y1="80" x2="200" y2="240" gradientUnits="userSpaceOnUse">
                        <stop stop-color="currentColor"/>
                        <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <!-- 404 Heading -->
        <h1 class="text-7xl sm:text-8xl md:text-9xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400 mb-4 drop-shadow-sm select-none">
            404
        </h1>
        
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-6 tracking-tight">
            Page Not Found
        </h2>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
            Oops! It looks like you've ventured off the beaten path. The page you are looking for doesn't exist or is temporarily unavailable.
        </p>

        <!-- Possible Reasons Section -->
        <div class="w-full max-w-3xl mx-auto bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 md:p-8 mb-12 text-left shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Possible reasons why this happened:
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-start gap-3 p-4 rounded-xl hover:bg-white dark:hover:bg-slate-700/50 transition-colors group">
                    <div class="bg-sky-100 dark:bg-sky-900/30 p-2 rounded-lg text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5 cursor-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                    </div>
                    <div>
                        <span class="block font-medium text-slate-900 dark:text-white">Incorrect URL</span>
                        <span class="text-sm text-slate-500 dark:text-slate-400 mt-1 block">The web address may contain a typo.</span>
                    </div>
                </div>
                
                <div class="flex items-start gap-3 p-4 rounded-xl hover:bg-white dark:hover:bg-slate-700/50 transition-colors group">
                    <div class="bg-amber-100 dark:bg-amber-900/30 p-2 rounded-lg text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </div>
                    <div>
                        <span class="block font-medium text-slate-900 dark:text-white">Page Removed</span>
                        <span class="text-sm text-slate-500 dark:text-slate-400 mt-1 block">The content has been permanently deleted.</span>
                    </div>
                </div>
                
                <div class="flex items-start gap-3 p-4 rounded-xl hover:bg-white dark:hover:bg-slate-700/50 transition-colors group">
                    <div class="bg-indigo-100 dark:bg-indigo-900/30 p-2 rounded-lg text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                    </div>
                    <div>
                        <span class="block font-medium text-slate-900 dark:text-white">Page Moved</span>
                        <span class="text-sm text-slate-500 dark:text-slate-400 mt-1 block">The page is relocated to a new address.</span>
                    </div>
                </div>
                
                <div class="flex items-start gap-3 p-4 rounded-xl hover:bg-white dark:hover:bg-slate-700/50 transition-colors group">
                    <div class="bg-emerald-100 dark:bg-emerald-900/30 p-2 rounded-lg text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div>
                        <span class="block font-medium text-slate-900 dark:text-white">Outdated Link</span>
                        <span class="text-sm text-slate-500 dark:text-slate-400 mt-1 block">The bookmark or reference is old.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action / Navigation Buttons Grid -->
        <div class="w-full">
            <h3 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-6">Let's get you back on track</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-6 max-w-4xl mx-auto">
                <!-- Home Action -->
                <a asp-controller="Home" asp-action="Index" class="group relative flex flex-col items-center p-6 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-2xl hover:border-sky-500 dark:hover:border-sky-500 hover:shadow-lg hover:shadow-sky-500/10 transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-sky-50 to-transparent dark:from-sky-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10 bg-slate-100 dark:bg-slate-700 p-3 rounded-full text-slate-600 dark:text-slate-300 group-hover:bg-sky-500 group-hover:text-white transition-colors duration-300 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                    </div>
                    <span class="relative z-10 text-lg font-semibold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">Return Home</span>
                    <span class="relative z-10 text-sm text-slate-500 dark:text-slate-400 mt-2 text-center group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors">Back to the frontpage</span>
                </a>

                <!-- Services Action -->
                <a asp-controller="Services" asp-action="Services" class="group relative flex flex-col items-center p-6 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-2xl hover:border-indigo-500 dark:hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 to-transparent dark:from-indigo-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10 bg-slate-100 dark:bg-slate-700 p-3 rounded-full text-slate-600 dark:text-slate-300 group-hover:bg-indigo-500 group-hover:text-white transition-colors duration-300 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <span class="relative z-10 text-lg font-semibold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Our Services</span>
                    <span class="relative z-10 text-sm text-slate-500 dark:text-slate-400 mt-2 text-center group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors">Browse what we offer</span>
                </a>

                <!-- Contact Action -->
                <a asp-controller="About" asp-action="ContactUs" class="group relative flex flex-col items-center p-6 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-2xl hover:border-emerald-500 dark:hover:border-emerald-500 hover:shadow-lg hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 to-transparent dark:from-emerald-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10 bg-slate-100 dark:bg-slate-700 p-3 rounded-full text-slate-600 dark:text-slate-300 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <span class="relative z-10 text-lg font-semibold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Contact Support</span>
                    <span class="relative z-10 text-sm text-slate-500 dark:text-slate-400 mt-2 text-center group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors">We're here to help</span>
                </a>
            </div>
        </div>
        
    </div>
</div>
