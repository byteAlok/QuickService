@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Something Went Wrong";
}

<div class=" relative w-full overflow-hidden rounded-2xl bg-white dark:bg-slate-800 shadow-xl border border-slate-100 dark:border-slate-700/60 p-0 sm:p-8 md:p-12 lg:p-16 text-center transform transition-all duration-500 hover:shadow-2xl">
    <!-- Dynamic Background Gradients specific to Generic Error -->
    <div class="absolute inset-0 pointer-events-none opacity-40 dark:opacity-20 z-0">
        <div class="absolute top-0 right-1/4 w-80 h-80 bg-fuchsia-200 dark:bg-fuchsia-900 rounded-full blur-3xl opacity-50 transform -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-blue-200 dark:bg-blue-900 rounded-full blur-3xl opacity-50 transform translate-y-1/2"></div>
    </div>

    <div class="relative z-10 flex flex-col items-center max-w-5xl mx-auto">
        <!-- Main Generic Error Visual / SVG Illustration -->
        <div class="relative mb-10 w-full max-w-md mx-auto group [perspective:1000px]">
            <div class="absolute inset-0 bg-fuchsia-400/20 dark:bg-fuchsia-900/40 rounded-full filter blur-3xl transform scale-75 group-hover:scale-100 transition-transform duration-700 ease-in-out"></div>
            
            <svg class="w-full h-auto text-slate-800 dark:text-slate-200 relative z-10" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Broken Document/Window -->
                <rect x="120" y="60" width="160" height="200" rx="12" fill="url(#genericGradient)" fill-opacity="0.1" stroke="currentColor" stroke-width="6"/>
                <path d="M120 100H280" stroke="currentColor" stroke-width="6"/>
                
                <!-- Window Controls -->
                <circle cx="140" cy="80" r="4" fill="#ef4444"/>
                <circle cx="156" cy="80" r="4" fill="#eab308"/>
                <circle cx="172" cy="80" r="4" fill="#22c55e"/>

                <!-- Content Lines -->
                <path d="M150 140H250" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
                <path d="M150 170H200" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
                
                <!-- Warning Triangle overlapping -->
                <g class="animate-[bounce_3s_infinite]" style="animation-duration: 4s;">
                    <path d="M250 130L340 280H160L250 130Z" fill="white" fill-opacity="0.9" class="dark:fill-slate-800"/>
                    <path d="M250 130L340 280H160L250 130Z" stroke="#f59e0b" stroke-width="8" stroke-linejoin="round"/>
                    <path d="M250 180V230" stroke="#f59e0b" stroke-width="8" stroke-linecap="round"/>
                    <circle cx="250" cy="255" r="5" fill="#f59e0b"/>
                </g>

                <!-- Small Floating Elements -->
                <path d="M80 150L90 140M90 150L80 140" stroke="#8b5cf6" stroke-width="4" stroke-linecap="round" class="animate-pulse"/>
                <circle cx="100" cy="240" r="8" fill="#3b82f6" fill-opacity="0.4" class="animate-bounce" style="animation-delay: 1s;"/>
                <circle cx="320" cy="80" r="12" fill="#ec4899" fill-opacity="0.3" class="animate-pulse" style="animation-delay: 0.5s;"/>

                <defs>
                    <linearGradient id="genericGradient" x1="120" y1="60" x2="280" y2="260" gradientUnits="userSpaceOnUse">
                        <stop stop-color="currentColor"/>
                        <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-6 tracking-tight">
            Something Went Wrong
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-12 leading-relaxed">
            We apologize for the inconvenience, but our system could not process your request at this time. This might be due to a temporary glitch or an invalid operation.
        </p>

        <!-- Detailed Scenarios Section -->
        <div class="w-full bg-slate-50 dark:bg-slate-900/40 rounded-3xl border border-slate-200 dark:border-slate-700/60 p-4 sm:p-6 md:p-8 lg:p-10 mb-14 text-left shadow-inner relative overflow-hidden">
            <!-- Decorative corner accent -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-slate-200 to-transparent dark:from-slate-700/50 rounded-bl-[100px] opacity-50 pointer-events-none"></div>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-3 relative z-10">
                <svg class="w-6 h-6 text-fuchsia-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Possible Scenarios
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 relative z-10">
                <!-- 401 Unauthorized -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 group">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="bg-blue-100 dark:bg-blue-900/30 p-3 rounded-xl text-blue-600 dark:text-blue-400 group-hover:scale-110 group-hover:rotate-3 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-blue-500 dark:text-blue-400 mb-1 block">401 Error</span>
                            <h4 class="text-lg font-semibold text-slate-900 dark:text-white">Unauthorized Access</h4>
                        </div>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                        The requested page requires authentication. Please ensure you are logged in to the correct account to view this resource.
                    </p>
                </div>

                <!-- 403 Forbidden -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 group">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="bg-rose-100 dark:bg-rose-900/30 p-3 rounded-xl text-rose-600 dark:text-rose-400 group-hover:scale-110 group-hover:-rotate-3 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-rose-500 dark:text-rose-400 mb-1 block">403 Error</span>
                            <h4 class="text-lg font-semibold text-slate-900 dark:text-white">Access Denied</h4>
                        </div>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                        You do not have permission to access this resource. Your account may lack the necessary privileges or role assignments.
                    </p>
                </div>

                <!-- Invalid Request -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 group">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="bg-amber-100 dark:bg-amber-900/30 p-3 rounded-xl text-amber-600 dark:text-amber-400 group-hover:scale-110 group-hover:rotate-3 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-amber-500 dark:text-amber-400 mb-1 block">400 Error</span>
                            <h4 class="text-lg font-semibold text-slate-900 dark:text-white">Invalid Request</h4>
                        </div>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                        The request may be malformed, incomplete, or unsupported by our application parameters. Please verify your input and try again.
                    </p>
                </div>

                <!-- Temporary System Issue -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 group">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="bg-emerald-100 dark:bg-emerald-900/30 p-3 rounded-xl text-emerald-600 dark:text-emerald-400 group-hover:scale-110 group-hover:-rotate-3 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-500 dark:text-emerald-400 mb-1 block">System Event</span>
                            <h4 class="text-lg font-semibold text-slate-900 dark:text-white">Temporary System Issue</h4>
                        </div>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                        The system may be experiencing technical difficulties. Our engineering team actively monitors for these occurrences.
                    </p>
                </div>
            </div>
        </div>

        <!-- Action / Navigation Buttons Grid -->
        <div class="w-full">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
                <!-- Home Action -->
                <a asp-controller="Home" asp-action="Index" class="w-full sm:w-auto px-8 py-3.5 bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 shadow-lg shadow-slate-900/20 dark:shadow-white/20 rounded-xl text-base font-semibold transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 dark:focus:ring-white flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Return Home
                </a>

                <!-- Services Action -->
                <a asp-controller="Services" asp-action="Services" class="w-full sm:w-auto px-8 py-3.5 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:border-slate-400 dark:hover:border-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 shadow-sm rounded-xl text-base font-medium transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    Services
                </a>

                <!-- Contact Support -->
                <a asp-controller="About" asp-action="ContactUs" class="w-full sm:w-auto px-8 py-3.5 bg-white dark:bg-slate-800 text-fuchsia-600 dark:text-fuchsia-400 border border-fuchsia-200 dark:border-fuchsia-900/50 hover:border-fuchsia-300 dark:hover:border-fuchsia-700 hover:bg-fuchsia-50 dark:hover:bg-fuchsia-900/20 shadow-sm rounded-xl text-base font-medium transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-fuchsia-500 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    Contact Support
                </a>
            </div>
            
            <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800 text-center">
                <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 text-fuchsia-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    If the problem persists, please reference the timestamp: <span class="font-mono bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded text-xs select-all">@DateTime.Now</span>
                </p>
            </div>
        </div>
        
    </div>
</div>
