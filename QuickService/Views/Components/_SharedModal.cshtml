

@* ----------- Status Complete Modal ----------------------*@

<div id="completeModal" class="fixed inset-0 flex items-center justify-center bg-black/40 hidden z-50">

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6 w-80">

        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">
            Complete Booking
        </h3>

        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
            Mark this booking as completed?
        </p>

        <div class="flex justify-end gap-2 mt-4">

            <button id="cancelComplete"
                    class="px-4 py-1 text-sm border rounded-full border-slate-300 dark:border-slate-600">
                Cancel
            </button>

            <button id="confirmComplete"
                    class="px-4 py-1 text-sm bg-emerald-600 hover:bg-emerald-700 text-white rounded-full">
                Complete
            </button>

        </div>

    </div>

</div>

@* ---------------------- Shared Message Modal -------------------- *@

<div id="shareModal" class="fixed inset-0 flex items-center justify-center bg-black/40 hidden z-50">

