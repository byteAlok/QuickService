@{
    ViewData["Title"] =
        "Frequently Asked Questions � Appliance Repair Service Help & Support | QuickService";

    ViewData["Description"] =
        "Find answers to common questions about appliance repair services, booking process, visit charges, warranty, technician availability & service areas. QuickService FAQ helps you understand AC, washing machine, refrigerator, RO, TV & electrician service details before booking.";
}

@section Styles {
    <style>
        details > summary {
            list-style: none;
        }

            details > summary::-webkit-details-marker {
                display: none;
            }

        details[open] summary ~ * {
            animation: sweep .3s ease-in-out;
        }

        @@keyframes sweep {
            0%

        {
            opacity: 0;
            transform: translateY(-10px)
        }

        100% {
            opacity: 1;
            transform: translateY(0)
        }

        }
    </style>
}


    <!--
    =======================================================================
    SECTION 1: HERO & SEARCH
    =======================================================================
    -->
    <header class="relative pt-10 pb-14 lg:pt-16 lg:pb-16 overflow-hidden bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 bg-gradient-to-br from-blue-100 to-purple-100 dark:from-gray-900 dark:to-gray-800">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#4285F4 1px, transparent 1px); background-size: 32px 32px;"></div>

        <div class="container max-w-5xl mx-auto px-6 text-center relative z-10">
            <span class="inline-block py-1 px-3 rounded-full bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-300 text-xs font-bold tracking-widest uppercase mb-6 border border-purple-100 dark:border-purple-800">
                Help Center
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6">
