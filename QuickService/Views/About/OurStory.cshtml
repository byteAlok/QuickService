@{
    ViewData["Title"] =
        "Our Story � Building a Trusted Home Appliance Repair Platform | QuickService";

    ViewData["Description"] =
        "Discover the journey of QuickService and how we built a trusted home appliance repair platform focused on verified technicians, transparent pricing & fast doorstep support to simplify service booking and improve customer satisfaction.";
}

@section Styles {

    <!-- Handwriting font for Founder's Signature -->
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet">

    <style>
        .timeline-line {
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e2e8f0;
            transform: translateX(-50%);
        }

        .dark .timeline-line {
            background: #374151;
        }

        @@media (max-width: 768px) {
            .timeline-line

        {
            left: 30px;
            transform: none;
        }

        }
    </style>
}

    <!--
    =======================================================================
    SECTION 1: HERO (NOSTALGIC)
    =======================================================================
    -->
    <header class="relative pt-12 pb-16 lg:pt-16 lg:pb-16 overflow-hidden bg-gradient-to-br from-blue-50 to-purple-50 dark:from-gray-900 dark:to-gray-800 border-b border-gray-100 dark:border-gray-800">
        <!-- Abstract Background -->
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23000000\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

        <div class="container max-w-5xl mx-auto px-6 text-center relative z-10">
            <span class="text-gray-400 font-bold tracking-widest uppercase text-xs mb-4 block">Since @SiteData.StartingSince</span>
            <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-8">
                It Started with a <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 to-red-600">Broken Fridge.</span>
            </h1>
            <p class="text-base sm:text-md md:text-xl text-gray-500 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed italic font-light">
                "We didn't set out to build a big company. We just wanted to fix appliances the right way�honestly, quickly, and reliably."
            </p>
        </div>
    </header>

    <!--
    =======================================================================
    SECTION 2: FOUNDER'S LETTER
    =======================================================================
    -->
    <section class="py-16 bg-white dark:bg-gray-800">
        <div class="container max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row gap-12 items-center md:items-start p-8 md:p-12 rounded-3xl bg-gray-50 dark:bg-gray-900 shadow-xl border border-gray-100 dark:border-gray-700">

                <!-- Founder Image Placeholder -->
                <div class="shrink-0 w-32 h-32 md:w-48 md:h-48 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center overflow-hidden border-4 border-white dark:border-gray-800 shadow-lg">
                    <i class="fa-solid fa-user-tie text-6xl text-gray-400"></i>
                </div>

                <!-- Text -->
                <div class="flex-1">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">A Note from Our Founder</h2>
                    <div class="text-gray-600 dark:text-gray-400 leading-loose space-y-4 font-normal">
                        <p>
                            Hello, I'm <strong>@SiteData.OwnerName</strong>.
                        </p>
                        <p>
                            Ten years ago, my own refrigerator broke down in the middle of a Hyderabad summer. I called three technicians. One never showed up, the second overcharged me for a part I didn't need, and the third left my kitchen in a mess.
                        </p>
                        <p>
                            I realized there was a massive gap in the market for a service that was simply <strong>professional</strong>. A service where "9 AM" meant 9 AM, not "sometime in the morning". Where prices were fixed, not verified by looking at the customer's car.
                        </p>
                        <p>
                            QuickService was born from that frustration. Today, we are a family of @SiteData.ExpertTeams technicians, but our core promise remains the same: <strong>We treat your home like our own.</strong>
                        </p>


                    <div class="mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">

                        <h2 class="font-medium text-2xl text-cyan-700 dark:text-cyan-500 mb-4">
                            Business Details :
                        </h2>

                        <div class="max-w-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700
                border-l-4 border-l-cyan-600 dark:border-l-cyan-400
                rounded-xl shadow-sm p-4">

    
                            <table class="text-sm border-separate border-spacing-x-4">

                                <tbody>

                                    <tr class="border-b border-gray-200 dark:border-gray-700 last:border-0">
                                        <td class="font-semibold text-gray-700 dark:text-gray-300 whitespace-nowrap p-2">
                                            <i class="fa-solid fa-building text-cyan-600 dark:text-cyan-400 mr-2"></i>
                                            Registered Business
                                        </td>
                                        <td class="font-medium tracking-widest text-gray-600 dark:text-gray-400 p-2">
                                            @SiteData.RegisteredBusiness
                                        </td>
                                    </tr>

                                    <tr class="border-b border-gray-200 dark:border-gray-700 last:border-0">
                                        <td class="font-semibold text-gray-700 dark:text-gray-300 whitespace-nowrap p-2">
                                            <i class="fa-solid fa-file-invoice text-cyan-600 dark:text-cyan-400 mr-2"></i>
                                            GSTIN
                                        </td>
                                        <td class="font-medium tracking-widest text-gray-600 dark:text-gray-400 p-2">
                                            @SiteData.GSTNumber
                                        </td>
                                    </tr>

                                    <tr class="border-b border-gray-200 dark:border-gray-700 last:border-0">
                                        <td class="font-semibold text-gray-700 dark:text-gray-300 whitespace-nowrap p-2">
                                            <i class="fa-solid fa-user text-cyan-600 dark:text-cyan-400 mr-2"></i>
                                            Proprietor
                                        </td>
                                        <td class="font-medium tracking-widest text-gray-600 dark:text-gray-400 p-2">
                                            @SiteData.ProprietorName
                                        </td>
                                    </tr>

                                    <tr class="border-b border-gray-200 dark:border-gray-700 last:border-0">
                                        <td class="font-semibold text-gray-700 dark:text-gray-300 whitespace-nowrap p-2">
                                            <i class="fa-solid fa-globe text-cyan-600 dark:text-cyan-400 mr-2"></i>
                                            Website
                                        </td>
                                        <td class="font-medium tracking-widest p-2">
                                            <a href="@SiteData.SiteUrl"
                                               class="text-blue-500 dark:text-cyan-400 hover:underline">
                                                @SiteData.CompanyName
                                            </a>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                  


                        </div>

                        <p class="italic mt-4 text-gray-600 dark:text-gray-400">
                            All services provided under QuickService are operated by @SiteData.RegisteredBusiness.
                        </p>

                    </div>
       
                    <div class="mt-8 pt-4 border-t font-medium border-gray-200 dark:border-gray-800">
                        <p class="font-medium text-2xl text-cyan-700 dark:text-cyan-500">@SiteData.ProprietorName</p>
                        <p class="text-xs text-gray-600 dark:text-gray-400 uppercase tracking-widest mt-1">Founder & CEO</p>
                    </div>
                   

                    </div>
                </div>
            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 3: THE TIMELINE
    =======================================================================
    -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900 overflow-hidden">
        <div class="container max-w-6xl mx-auto px-6 relative">

            <div class="text-center mb-16">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm mb-2 block">Our History</span>
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white">A Decade of Excellence</h2>
            </div>

            <div class="relative py-10">
                <!-- Vertical Line -->
                <div class="md:block hidden timeline-line"></div>

                <!-- 2016: The Beginning -->
                <div class="relative z-10 mb-16 md:mb-24 flex flex-col md:flex-row items-center w-full">
                    <div class="order-1 w-full md:w-5/12 md:text-right px-6">
                        <h3 class="text-3xl font-black text-gray-400 mb-2">@SiteData.StartingSince</h3>
                        <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">The Garage Startup</h4>
                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                            Started with just 2 technicians and a single scooter in a small garage in Hyderabad City. We focused only on AC repairs initially.
                        </p>
                    </div>
                    <div class="order-1 w-8 h-8 md:w-16 md:h-16 rounded-full bg-white dark:bg-gray-800 border-4 border-blue-600 shadow-lg shrink-0 flex items-center justify-center z-20 my-4 md:my-0">
                        <div class="w-3 h-3 md:w-5 md:h-5 bg-blue-600 rounded-full"></div>
                    </div>
                    <div class="order-1 w-full md:w-5/12 px-6"></div>
                </div>

                <!-- 2018: 1000 Customers -->
                <div class="relative z-10 mb-16 md:mb-24 flex flex-col md:flex-row-reverse items-center w-full">
                    <div class="order-1 w-full md:w-5/12 md:text-left px-6">
                        <h3 class="text-3xl font-black text-gray-400 mb-2">2018</h3>
                        <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Crossing 500 Customers</h4>
                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                            Word of mouth spread. We expanded our services to washing machines and refrigerators. Hired our first support staff member.
                        </p>
                    </div>
                    <div class="order-1 w-8 h-8 md:w-16 md:h-16 rounded-full bg-white dark:bg-gray-800 border-4 border-green-600 shadow-lg shrink-0 flex items-center justify-center z-20 my-4 md:my-0">
                        <div class="w-3 h-3 md:w-5 md:h-5 bg-green-600 rounded-full"></div>
                    </div>
                    <div class="order-1 w-full md:w-5/12 px-6"></div>
                </div>

                <!-- 2020: The Pandemic -->
                <div class="relative z-10 mb-16 md:mb-24 flex flex-col md:flex-row items-center w-full">
                    <div class="order-1 w-full md:w-5/12 md:text-right px-6">
                        <h3 class="text-3xl font-black text-gray-400 mb-2">2020</h3>
                        <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Safety First Protocol</h4>
                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                            While the world paused, essential repairs couldn't wait. We implemented industry-leading safety protocols (Masks, Sanitization) to keep serving safely.
                        </p>
                    </div>
                    <div class="order-1 w-8 h-8 md:w-16 md:h-16 rounded-full bg-white dark:bg-gray-800 border-4 border-yellow-500 shadow-lg shrink-0 flex items-center justify-center z-20 my-4 md:my-0">
                        <div class="w-3 h-3 md:w-5 md:h-5 bg-yellow-500 rounded-full"></div>
                    </div>
                    <div class="order-1 w-full md:w-5/12 px-6"></div>
                </div>

                <!-- 2023: NCR Expansion -->
                <div class="relative z-10 mb-16 md:mb-24 flex flex-col md:flex-row-reverse items-center w-full">
                    <div class="order-1 w-full md:w-5/12 md:text-left px-6">
                        <h3 class="text-3xl font-black text-gray-400 mb-2">2023</h3>
                        <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Taking Over Hyderabad</h4>
                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                            Opened regional office in Hyderabad. Our team grew to 30 technicians. Introduced digital invoicing and CRM booking.
                        </p>
                    </div>
                    <div class="order-1 w-8 h-8 md:w-16 md:h-16 rounded-full bg-white dark:bg-gray-800 border-4 border-red-600 shadow-lg shrink-0 flex items-center justify-center z-20 my-4 md:my-0">
                        <div class="w-3 h-3 md:w-5 md:h-5 bg-red-600 rounded-full"></div>
                    </div>
                    <div class="order-1 w-full md:w-5/12 px-6"></div>
                </div>

                <!-- 2026: Present Day -->
                <div class="relative z-10 flex flex-col md:flex-row items-center w-full">
                    <div class="order-1 w-full md:w-5/12 md:text-right px-6">
                        <h3 class="text-3xl font-black text-gray-400 mb-2">2026</h3>
                        <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Tech-Enabled Future</h4>
                        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                            Now serving 500+ homes monthly. Launching our web app for instant booking and live tracking of technicians.
                        </p>
                    </div>
                    <div class="order-1 w-8 h-8 md:w-16 md:h-16 rounded-full bg-blue-600 shadow-lg shrink-0 flex items-center justify-center z-20 my-4 md:my-0 animate-pulse">
                        <i class="fa-solid fa-flag text-white text-xl"></i>
                    </div>
                    <div class="order-1 w-full md:w-5/12 px-6"></div>
                </div>

            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 4: THEN vs NOW STATS
    =======================================================================
    -->
    <section class="py-16 bg-gradient-to-r from-gray-800 via-gray-950 to-gray-800 text-white text-center">
        <div class="container max-w-6xl mx-auto px-6">
            <h2 class="text-3xl font-bold mb-12">Growth by the Numbers</h2>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">

                <div class="p-6 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
                    <div class="opacity-50 text-xs sm:text-sm mb-1 uppercase tracking-widest">Technicians</div>
                    <div class="text-3xl sm:text-4xl font-black mb-2 flex items-baseline justify-center gap-2">
                        <span class="text-base sm:text-xl opacity-60 line-through">2</span>
                        <span>@SiteData.ExpertTeams</span>
                    </div>
                    <div class="text-xs text-blue-200">25x Growth</div>
                </div>

                <div class="p-6 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
                    <div class="opacity-50 text-xs sm:text-sm mb-1 uppercase tracking-widest">Cities</div>
                    <div class="text-3xl sm:text-4xl font-black mb-2 flex items-baseline justify-center gap-2">
                        <span class="text-base sm:text-xl opacity-60 line-through">1</span>
                        <span>@SiteData.CitiesCovered</span>
                    </div>
                    <div class="text-xs text-blue-200">Hyderabad</div>
                </div>

                <div class="p-6 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
                    <div class="opacity-50 text-xs sm:text-sm mb-1 uppercase tracking-widest">Services</div>
                    <div class="text-3xl sm:text-4xl font-black mb-2 flex items-baseline justify-center gap-2">
                        <span class="text-base sm:text-xl opacity-60 line-through">4</span>
                        <span>@SiteData.Services</span>
                    </div>
                    <div class="text-xs text-blue-200">Categories</div>
                </div>

                <div class="p-6 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
                    <div class="opacity-50 text-xs sm:text-sm mb-1 uppercase tracking-widest">Office</div>
                    <div class="text-3xl sm:text-4xl font-black mb-2 flex items-baseline justify-center gap-2">
                        <span class="text-base sm:text-xl opacity-60 line-through">Garage</span>
                        <span>HQ</span>
                    </div>
                    <div class="text-xs text-blue-200">Level Up</div>
                </div>

            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 5: CTA
    =======================================================================
    -->
    <section class="py-16 bg-white dark:bg-gray-800">
        <div class="container max-w-3xl mx-auto px-6 text-center">
            <h2 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">Be Part of Our Story</h2>
            <p class="text-lg text-gray-600 dark:text-gray-400 mb-10 leading-relaxed">
                Whether you need a repair or want to join our team of expert technicians, we welcome you to the family.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a asp-action="ContactUs" asp-controller="About" class="px-12 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold rounded-xl transition-all shadow-lg hover:shadow-xl hover:-translate-y-1">
                    Contact Us
                </a>
                <a asp-action="Services" asp-controller="Services" class="px-10 py-4 bg-transparent border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white font-bold rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-gray-700">
                    Explore Services
                </a>
            </div>
        </div>
    </section>



