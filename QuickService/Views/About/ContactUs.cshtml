    <!--
    =======================================================================
    SECTION 5: FAQ & Help
    =======================================================================
    -->
    <section class="py-16 md:py-24 bg-blue-50 dark:bg-black/20 border-t border-gray-200 dark:border-gray-800">
        <div class="container max-w-4xl mx-auto px-6 text-center">

            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/20 text-blue-600 text-2xl mb-6 animate-pulse-slow">
                <i class="fa-solid fa-question"></i>
            </div>

            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Have Questions?</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-10">
                Check our Frequently Asked Questions for quick answers about pricing, warranty, and service areas.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
                <!-- FAQ Item 1 -->
            <a asp-action="FrequentlyAskedQuestion" asp-controller="About" class="block p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-600 dark:hover:border-blue-600 transition-all">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-1"><i class="fa-regular fa-clock mr-2 text-gray-400"></i> What are your working hours?</h4>
                    <p class="text-sm text-gray-500 ml-6">We are open 7 days a week, 9 AM to 8 PM.</p>
                </a>

                <!-- FAQ Item 2 -->
            <a asp-action="Pricing" asp-controller="About" class="block p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-600 dark:hover:border-blue-600 transition-all">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-1"><i class="fa-solid fa-tag mr-2 text-gray-400"></i> How much is the visit charge?</h4>
                    <p class="text-sm text-gray-500 ml-6">Visit charges start at Rs.199 depending on the appliance.</p>
                </a>

                <!-- FAQ Item 3 -->
            <a asp-action="ContactUs" asp-controller="About" class="block p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-600 dark:hover:border-blue-600 transition-all">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-1"><i class="fa-solid fa-map-pin mr-2 text-gray-400"></i> Which areas do you serve?</h4>
                    <p class="text-sm text-gray-500 ml-6">We cover all major areas in Hyderabad</p>
                </a>

                <!-- FAQ Item 4 -->
            <a asp-action="FrequentlyAskedQuestion" asp-controller="About" class="block p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-600 dark:hover:border-blue-600 transition-all">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-1"><i class="fa-solid fa-shield-halved mr-2 text-gray-400"></i> Do you provide warranty?</h4>
                    <p class="text-sm text-gray-500 ml-6">Yes, 30-90 days warranty on spare parts.</p>
                </a>
            </div>

            <div class="mt-10">
            <a asp-action="FrequentlyAskedQuestion" asp-controller="About" class="bg-gray-900 dark:bg-gray-200 px-12 py-3 inline-flex items-center gap-2 text-gray-100 dark:text-gray-950 rounded-full font-semibold hover:scale-105 transition-all">
                    View All FAQs <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
         

        </div>
    </section>

