@{
    ViewData["Title"] =
        "Our Mission & Vision � Reliable Home Appliance Repair Services | QuickService";

    ViewData["Description"] =
        "Discover QuickService's mission and vision to deliver reliable home appliance repair services with verified technicians, transparent pricing & fast doorstep support. We aim to simplify AC, washing machine, refrigerator, RO, TV & electrician service booking with trust and customer satisfaction.";
}
