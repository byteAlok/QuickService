    <!--
    =======================================================================
    SECTION 1: HERO
    =======================================================================
    -->
    <header class="relative pt-14 pb-32 lg:pt-20 lg:pb-36 overflow-hidden bg-gray-900 text-white">
        <!-- Decoration -->
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop')] bg-cover bg-center opacity-20 filter blur-sm scale-110"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/80 to-transparent"></div>

        <div class="container max-w-6xl mx-auto px-6 text-center relative z-10">
            <span class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-blue-300 text-xs font-bold tracking-widest uppercase mb-6 backdrop-blur-md">
                Our Purpose
            </span>
            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-8">
                Repairing the <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Future of Service.</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed font-light">
                We envision a world where home maintenance is effortless, transparent, and sustainable.
            </p>
        </div>
    </header>

    <!--
    =======================================================================
    SECTION 2: MISSION & VISION CARDS
    =======================================================================
    -->
    <section class="relative -mt-20 z-20 pb-16">
        <div class="container max-w-6xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Mission Card -->
                <div class="bg-white dark:bg-gray-800 p-10 rounded-3xl shadow-2xl border-t-4 border-blue-600 hover:-translate-y-2 transition-transform duration-300 group">
                    <div class="w-16 h-16 rounded-2xl bg-blue-50 dark:bg-blue-900/20 text-blue-600 flex items-center justify-center text-3xl mb-8 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Our Mission</h2>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-lg">
                        To simplify home appliance care by providing <strong>reliable, transparent, and high-quality</strong> repair services at the click of a button, ensuring every home runs smoothly.
                    </p>
                </div>

                <!-- Vision Card -->
                <div class="bg-white dark:bg-gray-800 p-10 rounded-3xl shadow-2xl border-t-4 border-green-600 hover:-translate-y-2 transition-transform duration-300 group">
                    <div class="w-16 h-16 rounded-2xl bg-green-50 dark:bg-green-900/20 text-green-600 flex items-center justify-center text-3xl mb-8 group-hover:bg-green-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-eye"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Our Vision</h2>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-lg">
                        To become India's most trusted home service brand, setting the gold standard for <strong>professionalism, safety, and customer satisfaction</strong> in the unorganized repair sector.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 3: CORE VALUES
    =======================================================================
    -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900">
        <div class="container max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm mb-2 block">What We Stand For</span>
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white">Our Core Values</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

                <!-- Value 1 -->
                <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow">
                    <i class="fa-solid fa-scale-balanced text-4xl text-purple-500 mb-6"></i>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Integrity First</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                        We believe in radical honesty. No hidden charges, no fake parts, no unnecessary repairs. We do what is right, even when no one is watching.
                    </p>
                </div>

                <!-- Value 2 -->
                <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow">
                    <i class="fa-solid fa-heart text-4xl text-red-500 mb-6"></i>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Empathy</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                        We understand the stress of a broken appliance. We treat every customer with patience, respect, and a genuine desire to help.
                    </p>
                </div>

                <!-- Value 3 -->
                <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow">
                    <i class="fa-solid fa-bolt text-4xl text-yellow-500 mb-6"></i>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Excellence</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                        We don't do 'temporary fixes'. We strive for technical perfection in every repair job, ensuring longevity and performance.
                    </p>
                </div>

                <!-- Value 4 -->
                <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow">
                    <i class="fa-solid fa-users text-4xl text-blue-500 mb-6"></i>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Community</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                        We are committed to uplifting the technician community by providing dignity, training, and fair wages to our partners.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 4: SUSTAINABILITY (GREEN REPAIR)
    =======================================================================
    -->
    <section class="py-16 bg-green-50 dark:bg-gray-900 border-y border-green-100 dark:border-gray-800 relative overflow-hidden">
        <!-- Decoration -->
        <div class="absolute -right-20 -top-20 w-96 h-96 bg-green-200 dark:bg-green-900/20 rounded-full blur-3xl opacity-50 pointer-events-none"></div>

        <div class="container max-w-6xl mx-auto px-6 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-16">

                <div class="lg:w-1/2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 font-bold text-xs uppercase mb-6">
                        <i class="fa-solid fa-leaf"></i> Sustainability Initiative
                    </div>
                    <h2 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">Repair, Don't Replace.</h2>
                    <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
                        Every year, millions of tons of e-waste end up in landfills. At QuickService, we are on a mission to extend the lifespan of your appliances, reducing waste and carbon footprint.
                    </p>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-circle-check text-green-500"></i>
                            <span class="text-gray-700 dark:text-gray-300">Proper disposal of hazardous e-waste parts</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-circle-check text-green-500"></i>
                            <span class="text-gray-700 dark:text-gray-300">Prioritizing component-level repair over replacement</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-circle-check text-green-500"></i>
                            <span class="text-gray-700 dark:text-gray-300">Paperless digital invoicing system</span>
                        </li>
                    </ul>
                </div>

                <div class="lg:w-1/2">
                    <div class="bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-700">
                        <div class="flex items-center justify-between mb-8 border-b border-gray-100 dark:border-gray-700 pb-4">
                            <h3 class="font-bold text-xl text-gray-900 dark:text-white">Our Impact 2025</h3>
                            <span class="text-green-600 font-bold bg-green-50 dark:bg-green-900/30 px-3 py-1 rounded-lg text-sm">Yearly Report</span>
                        </div>

                        <div class="grid grid-cols-2 gap-8 text-center">
                            <div>
                                <div class="text-4xl font-black text-gray-900 dark:text-white mb-1">2000+</div>
                                <div class="text-xs text-gray-500 uppercase tracking-wide">Appliances Saved</div>
                            </div>
                            <div>
                                <div class="text-4xl font-black text-gray-900 dark:text-white mb-1">5 Ton</div>
                                <div class="text-xs text-gray-500 uppercase tracking-wide">E-Waste Prevented</div>
                            </div>
                            <div>
                                <div class="text-4xl font-black text-gray-900 dark:text-white mb-1">100%</div>
                                <div class="text-xs text-gray-500 uppercase tracking-wide">Paperless</div>
                            </div>
                            <div>
                                <div class="text-4xl font-black text-gray-900 dark:text-white mb-1">450+</div>
                                <div class="text-xs text-gray-500 uppercase tracking-wide">Trees Planted</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!--
    =======================================================================
    SECTION 5: CTA
    =======================================================================
    -->
    <section class="py-16 bg-white dark:bg-gray-800">
        <div class="container max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl md:text-5xl font-semibold text-gray-900 dark:text-white mb-8">Join Our Mission</h2>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a asp-action="ContactUs" asp-controller="About" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-sky-700 hover:bg-blue-600 text-white font-semibold rounded-xl transition-all shadow-lg hover:shadow-blue-500/50">
                    Partner With Us
                </a>
                <a asp-action="OurStory" asp-controller="About" class="px-8 py-4 bg-transparent border border-gray-500 dark:border-gray-700 text-gray-900 dark:text-white font-semibold rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-gray-800">
                    Read Our Story
                </a>
            </div>
        </div>
    </section>


