@{
    ViewData["Title"] =
        "Appliance Repair Pricing & Visit Charges � Affordable Service Cost | QuickService";

    ViewData["Description"] =
        "Check QuickService appliance repair pricing and visit charges for AC, washing machine, refrigerator, RO, TV & electrician services. Transparent pricing, no hidden fees, affordable repair cost & doorstep technician support with easy online booking.";
}
@section Styles {

    <style>
        /* Typography Scale Fixes for Mobile */
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            line-height: 1.2;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        .dark ::-webkit-scrollbar-track {
            background: #0f172a;
        }

        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }

        /* Gradient Text Utilities */
        .text-gradient-blue {
            background: linear-gradient(135deg, #4285F4 0%, #00d2ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Glass Cards */
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }

        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Pricing Table Row Hover */
        .pricing-row:hover {
            background-color: rgba(66, 133, 244, 0.05);
        }
    </style>
}

    <!--
        =============================================
        1. HERO SECTION
        =============================================
    -->
    <header class="relative pt-10 pb-10 lg:pt-16 lg:pb-16 overflow-hidden">
        <!-- Decoration -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none">
            <div class="absolute top-20 right-10 w-32 h-32 lg:w-64 lg:h-64 bg-green-400/10 rounded-full blur-3xl animate-float"></div>
            <div class="absolute bottom-20 left-10 w-40 h-40 lg:w-80 lg:h-80 bg-blue-400/10 rounded-full blur-3xl animate-float" style="animation-delay: -2s;"></div>
        </div>

        <div class="container max-w-7xl mx-auto px-4 text-center relative z-10">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm mb-6 animate-fade-in-up">
                <i class="fa-solid fa-tag text-green-600 text-xs"></i>
                <span class="text-xs font-bold tracking-wider uppercase text-gray-600 dark:text-gray-300">No Hidden Costs</span>
            </div>

            <!-- Heading -->
            <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6 leading-tight animate-fade-in-up" style="animation-delay: 0.1s;">
                Honest, Transparent <br>
                <span class="text-gradient-blue">Service Pricing</span>
            </h1>

            <!-- Subtext -->
            <p class="text-base sm:text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in-up px-4" style="animation-delay: 0.2s;">
                Know exactly what you pay for. We believe in fair pricing for professional work, verified experts, and genuine spare parts.
            </p>

            <!-- Disclaimer Box -->
            <div class="max-w-3xl mx-auto bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-800/30 rounded-xl p-4 mb-8 text-sm text-gray-600 dark:text-gray-400 animate-fade-in-up" style="animation-delay: 0.3s;">
                <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i>
                <span class="font-medium">Important:</span> A standard visiting charge applies if you choose not to proceed with the repair after diagnosis. This covers our technician's time and travel expenses.
            </div>
        </div>
    </header>

    <!--
        =============================================
        2. PRICING SECTIONS
        =============================================
    -->
