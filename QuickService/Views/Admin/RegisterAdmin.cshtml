@model QuickService.Models.AdminModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Registration";
}
@section Styles {
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    }
    .dark .glass-card {
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .premium-title {
        background: linear-gradient(to right, #111827, #4b5563);
        -webkit-background-clip: text; color: transparent;
    }
    .dark .premium-title {
        background: linear-gradient(to right, #f9fafb, #d1d5db);
        -webkit-background-clip: text; color: transparent;
    }
    .btn-gradient {
        background: linear-gradient(to right, #4f46e5 0%, #0ea5e9 51%, #4f46e5 100%);
        background-size: 200% auto;
        border: none; transition: 0.5s;
    }
    .btn-gradient:hover {
        background-position: right center;
        box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);
        color: white; transform: translateY(-1px);
    }
</style>
}

@{
    var status = TempData["AdminType"] as string;
    // var status = "Server-side error or failed!. Please try again.";
    var type = TempData["AdminStatus"] as string;
    // var type = "error";
}

@if (!string.IsNullOrEmpty(status))
{
    <div class="flex justify-center mt-4">

        @if (type == "error")
        {
            <div class="flex items-center gap-3 px-6 py-3 border
                                                        border-red-300 bg-red-100 text-red-800
                                                        dark:border-red-600 dark:bg-red-900/40 dark:text-red-200
                                                        shadow-lg max-w-xl w-full rounded-md">

                <i class="fa-solid fa-triangle-exclamation text-2xl text-red-600 dark:text-red-200"></i>

                <div>
                    <h4 class="font-semibold pb-1 sm:pb-0 text-base leading-tight">
                        Staff Registration Failed...
                    </h4>
                    <p class="text-sm opacity-90">@status</p>
                </div>
            </div>
        }

    </div>
}


<div class="w-full max-w-4xl mx-auto px-4 my-8">

    <!-- Card -->
    <div class="glass-card shadow-2xl rounded-2xl p-6 sm:p-8">

        <!-- Header -->
        <div class="text-center mb-8">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 14px; background: rgba(99, 102, 241, 0.1); color: #4f46e5; margin-bottom: 12px;">
                <svg style="width: 28px; height: 28px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold premium-title">
                Get Started as Admin
            </h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Setup your new administrator account for the portal
            </p>
        </div>

        <form method="post" enctype="multipart/form-data" id="registerAdminForm" class="space-y-6">
            @Html.AntiForgeryToken()
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Account Details Section -->
                <div class="space-y-5">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 border-b border-slate-200 dark:border-slate-700 pb-2">Account Details</h3>
                    
                    <div>
                        <label asp-for="admin_name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Full Name *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </span>
                            <input asp-for="admin_name" placeholder="John Doe" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="admin_name" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="admin_email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Email Address *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </span>
                            <input asp-for="admin_email" placeholder="john@example.com" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="admin_email" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="admin_password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Password *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </span>
                            <input asp-for="admin_password" type="password" id="passwordField" placeholder="••••••••" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-10 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                            <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-2 flex items-center pr-2 text-slate-400 hover:text-blue-500 transition-colors" style="outline: none;">
                                <svg id="eyeIcon" style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="admin_password" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="admin_phone" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Phone Number *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </span>
                            <input asp-for="admin_phone" placeholder="90000 00000" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="admin_phone" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
      
                    <div>
                        <label asp-for="admin_type" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Admin Role *</label> 
                        <div class="relative">
                                <select asp-for="admin_type" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors appearance-none">
                                    <option value="">-- Select Role --</option>
                                    <option value="SuperAdmin">Super Admin</option>
                                    <option value="Manager">Manager</option>
                                </select>
                        </div>
                        <span asp-validation-for="admin_type" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>


                <!-- Personal Profile Section -->
                <div class="space-y-5">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 border-b border-slate-200 dark:border-slate-700 pb-2">Profile Information (Optional)</h3>

                    <div>
                        <label asp-for="admin_address" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Address</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </span>
                            <input asp-for="admin_address" placeholder="Detailed Address..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-10 pr-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="admin_address" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div class="col-span-1">
                            <label asp-for="admin_city_state" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">City/State</label>
                            <input asp-for="admin_city_state" placeholder="City/State Name" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2.5 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
                            <span asp-validation-for="admin_city_state" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        
                    </div>
                </div>

            </div>            <!-- Submit -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700">
                <button type="submit" id="registerBtn" class="btn-gradient w-full md:w-auto md:min-w-[200px] flex items-center justify-center gap-2 font-semibold py-3 px-8 rounded-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed text-white shadow-lg shadow-blue-500/30 mx-auto">
                    <svg id="spinner" class="hidden animate-spin" style="height: 20px; width: 20px; color: white;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span id="btnText">Create Admin Account</span>
                    <svg style="width: 18px; height: 18px; margin-left: 4px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </button>
                
                <div class="text-center mt-6">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        Already have an account? 
                        <a href="@Url.Action("Login", "Auth")" class="font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 hover:underline transition-colors">Login</a>
                    </p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePassword() {
            const field = document.getElementById("passwordField");
            const icon = document.getElementById("eyeIcon");
            
            if (field.type === "password") {
                field.type = "text";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />`;
            } else {
                field.type = "password";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
            }
        }

        document.getElementById("registerAdminForm").addEventListener("submit", function (e) {
            if($(this).valid() === false) return;
            
            const btn = document.getElementById("registerBtn");
            btn.disabled = true;
            document.getElementById("spinner").classList.remove("hidden");
            document.getElementById("btnText").innerText = "Creating Account...";
        });
    </script>
}
